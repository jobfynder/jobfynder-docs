om/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/91d5e520c9ed...a83750570a68","commits":[{"id":"a83750570a68ae0c2fc3178af3a0e342be4ced3c","tree_id":"2ec474388143675ecb8dcec33618b93d84f9e9d9","distinct":true,"message":"docs(reporting): record the DATA/Contract/AI job-title root cause\n\nFollow-up to the top_job_titles noise-filter comment. Investigated\nfurther and found this wasn't a classifier bug at all: DATA, Contract,\nAI, ServiceNow, and Mobile were canonical entries in job_titles.json,\napproved via the ordinary human-reviewer candidate-approval flow.\nRemoved them with the existing bulk_delete_job_titles() (advisory-\nlocked, writes to the persistent /hermes-runtime volume, busts the\nmtime cache -- live immediately, no redeploy, confirmed new text no\nlonger matches any of the five). Updated the docstring so the next\nreader sees the real story instead of a stale \"classifier accuracy\nissue, left visible\" note that no longer reflects what's true --\nhistorical drafts parsed before the deletion correctly keep their old\nvalues as a snapshot of what was actually extracted at the time.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-02T19:35:42-04:00","url":"https://github.com/jobfynder/hermes/commit/a83750570a68ae0c2fc3178af3a0e342be4ced3c","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-09-02T19:35:42-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-09-02T19:35:42-04:00"},"added":[],"removed":[],"modified":["app/reporting/service.py"]}],"head_commit":{"id":"a83750570a68ae0c2fc3178af3a0e342be4ced3c","tree_id":"2ec474388143675ecb8dcec33618b93d84f9e9d9","distinct":true,"message":"docs(reporting): record the DATA/Contract/AI job-title root cause\n\nFollow-up to the top_job_titles noise-filter comment. Investigated\nfurther and found this wasn't a classifier bug at all: DATA, Contract,\nAI, ServiceNow, and Mobile were canonical entries in job_titles.json,\napproved via the ordinary human-reviewer candidate-approval flow.\nRemoved them with the existing bulk_delete_job_titles() (advisory-\nlocked, writes to the persistent /hermes-runtime volume, busts the\nmtime cache -- live immediately, no redeploy, confirmed new text no\nlonger matches any of the five). Updated the docstring so the next\nreader sees the real story instead of a stale \"classifier accuracy\nissue, left visible\" note that no longer reflects what's true --\nhistorical drafts parsed before the deletion correctly keep their old\nvalues as a snapshot of what was actually extracted at the time.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-02T19:35:42-04:00","url":"https://github.com/jobfynder/hermes/commit/a83750570a68ae0c2fc3178af3a0e342be4ced3c","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-09-02T19:35:42-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-09-02T19:35:42-04:00"},"added":[],"removed":[],"modified":["app/reporting/service.py"]}}
