m/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/1f5f4f9dd6c2...a2f22213b3c2","commits":[{"id":"a2f22213b3c2ff045a3dc709057602eb70e0d993","tree_id":"d526c80335ca0ec08b0f19d604535fc604159008","distinct":true,"message":"fix(moderation): GET /taxonomy-candidates and /blocklist 500'd on any real row\n\nTaxonomyCandidateEntry/BlocklistEntry declare their timestamp fields as\nstr, but list_taxonomy_candidates/list_blocks/add_block returned raw\npsycopg datetime objects -- FastAPI's response validation rejects a\ndatetime where str is declared instead of stringifying it, so both\nendpoints 500'd the moment a real row existed. Never caught earlier\nbecause both tables were empty in every prior smoke test; surfaced in\nproduction once a real taxonomy candidate (\"ORMB Technical Consultant\")\ngot queued and someone opened the Blocklist & taxonomy page.\n\nFixed by explicitly calling .isoformat() before returning, the same\npattern _row_to_draft (app/drafts/service.py) already uses for drafts.\n\nNew coverage: hits the actual HTTP response path via TestClient (not\njust the DB function) for GET /taxonomy-candidates and POST+GET\n/blocklist, since the bug was specifically in response serialization,\nnot the query itself. Full regression suite (18 checks) green.","timestamp":"2026-08-29T21:56:45-04:00","url":"https://github.com/jobfynder/hermes/commit/a2f22213b3c2ff045a3dc709057602eb70e0d993","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T21:56:45-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T21:56:45-04:00"},"added":[],"removed":[],"modified":["app/email_parsing/blocklist.py","app/understanding/taxonomy/candidates.py","scripts/hermes-900-spam-taxonomy-check.py"]}],"head_commit":{"id":"a2f22213b3c2ff045a3dc709057602eb70e0d993","tree_id":"d526c80335ca0ec08b0f19d604535fc604159008","distinct":true,"message":"fix(moderation): GET /taxonomy-candidates and /blocklist 500'd on any real row\n\nTaxonomyCandidateEntry/BlocklistEntry declare their timestamp fields as\nstr, but list_taxonomy_candidates/list_blocks/add_block returned raw\npsycopg datetime objects -- FastAPI's response validation rejects a\ndatetime where str is declared instead of stringifying it, so both\nendpoints 500'd the moment a real row existed. Never caught earlier\nbecause both tables were empty in every prior smoke test; surfaced in\nproduction once a real taxonomy candidate (\"ORMB Technical Consultant\")\ngot queued and someone opened the Blocklist & taxonomy page.\n\nFixed by explicitly calling .isoformat() before returning, the same\npattern _row_to_draft (app/drafts/service.py) already uses for drafts.\n\nNew coverage: hits the actual HTTP response path via TestClient (not\njust the DB function) for GET /taxonomy-candidates and POST+GET\n/blocklist, since the bug was specifically in response serialization,\nnot the query itself. Full regression suite (18 checks) green.","timestamp":"2026-08-29T21:56:45-04:00","url":"https://github.com/jobfynder/hermes/commit/a2f22213b3c2ff045a3dc709057602eb70e0d993","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T21:56:45-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T21:56:45-04:00"},"added":[],"removed":[],"modified":["app/email_parsing/blocklist.py","app/understanding/taxonomy/candidates.py","scripts/hermes-900-spam-taxonomy-check.py"]}}
