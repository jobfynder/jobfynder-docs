ithub.com/repos/jobfynder/hermes/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-09-08T16:34:58Z","pushed_at":1788889425,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":851,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":true,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/commit/f52665a3f0f1","commits":[{"id":"f52665a3f0f1cff27616551ca9f44ef7b787026b","tree_id":"1b84da2abd695172c57d45303460eb399502a34a","distinct":true,"message":"fix(email-parsing): fill job-requirement company from the signature parser before LLM fallback\n\ncompany_missing is the single largest requires_review driver in\nproduction (67% of all review warnings, HERMES-950 review-queue\nreport), because most recruiter emails never label \"Company:\"\nexplicitly. Hermes already extracts this deterministically via the\nsignature-block parser (100% precision, 32% fill rate across all\ndrafts) but that value was never wired into the job-requirement\nrecord's own company field, which the 0.70 confidence gate actually\nlooks at -- so a value Hermes had already found kept getting sent to\nreview anyway.\n\napply_signature_company_fill() (app/email_parsing/parsers.py) closes\nthat gap: only fills company when it's genuinely empty, never\noverrides a deterministic hit, and is restricted to the single-job\ncase (same reasoning apply_job_requirement_fallback already uses for\nmulti-position emails). It runs before the LLM fallback in\napp/channels/service.py so a successful fill can push confidence\nabove threshold and skip the LLM call entirely -- deterministic\nsignals resolve the gap first, LLM stays a genuine last resort given\nthis traffic volume and its cost.\n\nAdds scripts/hermes-850-signature-company-fill-check.py (wired into\nthe CI regression suite) covering the fill, the never-overrides\nguarantee, the multi-position exclusion, and that a resolvable case\nnever reaches the mocked LLM call.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T13:40:11-04:00","url":"https://github.com/jobfynder/hermes/commit/f52665a3f0f1cff27616551ca9f44ef7b787026b","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:40:11-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:40:11-04:00","username":"jobfynder"},"added":["scripts/hermes-850-signature-company-fill-check.py"],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/channels/service.py","app/email_parsing/parsers.py","app/email_parsing/provenance.py"]}],"head_commit":{"id":"f52665a3f0f1cff27616551ca9f44ef7b787026b","tree_id":"1b84da2abd695172c57d45303460eb399502a34a","distinct":true,"message":"fix(email-parsing): fill job-requirement company from the signature parser before LLM fallback\n\ncompany_missing is the single largest requires_review driver in\nproduction (67% of all review warnings, HERMES-950 review-queue\nreport), because most recruiter emails never label \"Company:\"\nexplicitly. Hermes already extracts this deterministically via the\nsignature-block parser (100% precision, 32% fill rate across all\ndrafts) but that value was never wired into the job-requirement\nrecord's own company field, which the 0.70 confidence gate actually\nlooks at -- so a value Hermes had already found kept getting sent to\nreview anyway.\n\napply_signature_company_fill() (app/email_parsing/parsers.py) closes\nthat gap: only fills company when it's genuinely empty, never\noverrides a deterministic hit, and is restricted to the single-job\ncase (same reasoning apply_job_requirement_fallback already uses for\nmulti-position emails). It runs before the LLM fallback in\napp/channels/service.py so a successful fill can push confidence\nabove threshold and skip the LLM call entirely -- deterministic\nsignals resolve the gap first, LLM stays a genuine last resort given\nthis traffic volume and its cost.\n\nAdds scripts/hermes-850-signature-company-fill-check.py (wired into\nthe CI regression suite) covering the fill, the never-overrides\nguarantee, the multi-position exclusion, and that a resolvable case\nnever reaches the mocked LLM call.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T13:40:11-04:00","url":"https://github.com/jobfynder/hermes/commit/f52665a3f0f1cff27616551ca9f44ef7b787026b","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:40:11-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:40:11-04:00","username":"jobfynder"},"added":["scripts/hermes-850-signature-company-fill-check.py"],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/channels/service.py","app/email_parsing/parsers.py","app/email_parsing/provenance.py"]}}
