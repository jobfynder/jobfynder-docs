er@users.noreply.github.com","date":"2026-11-13T01:18:56-05:00","username":"jobfynder"},"added":["src/resume/ats-v1/__fixtures__/sample.html","src/resume/ats-v1/__fixtures__/sample.json","src/resume/ats-v1/__fixtures__/sample.txt","src/resume/ats-v1/ats-v1.dto.ts","src/resume/ats-v1/ats-v1.mapper.spec.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/ats-v1.service.spec.ts","src/resume/ats-v1/ats-v1.service.ts","src/resume/ats-v1/fit/page-fit.ts","src/resume/ats-v1/render/docx.renderer.ts","src/resume/ats-v1/render/format.ts","src/resume/ats-v1/render/pdf.renderer.ts","src/resume/ats-v1/render/render.spec.ts","src/resume/ats-v1/render/text-html.renderer.ts","src/resume/ats-v1/schema/resume.schema.json","src/resume/ats-v1/schema/resume.types.ts","src/resume/ats-v1/templates/resume.css","src/resume/ats-v1/templates/resume.html.njk","src/resume/ats-v1/templates/resume.txt.njk","src/resume/ats-v1/validation/lint.rules.ts","src/resume/ats-v1/validation/schema-validator.ts","src/resume/ats-v1/validation/validation.spec.ts"],"removed":[],"modified":["nest-cli.json","package-lock.json","package.json","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts","src/resume/resume.module.ts"]},{"id":"30958d4875fc0b16c23fa10a7e0f8689bef4f630","tree_id":"71b86d326365c23abebdeb1446bce2a44f8a2168","distinct":false,"message":"feat(resume): ATS v1 template gaps - keywords, contact override, round-trip, deploy docs\n\n- builder fields: end client, employment type, environment; remote/location parsing; clearer error hints\n- keyword analysis against a pasted job description (deterministic, per-sentence weighting)\n- contact override and target job flow into the template\n- GET /resume/templates reports PDF availability; docs + env example for Chromium\n- fix: enableImplicitConversion turned experience/education/certifications objects into arrays on save\n- export -> platform text extractor round-trip tests\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T01:54:33-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/30958d4875fc0b16c23fa10a7e0f8689bef4f630","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T01:54:33-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T01:54:33-05:00","username":"jobfynder"},"added":["docs/resume/ats-template-v1.md","scripts/ats-pdf-roundtrip.cjs","src/resume/ats-v1/keywords/keyword-analyzer.spec.ts","src/resume/ats-v1/keywords/keyword-analyzer.ts","src/resume/ats-v1/roundtrip.spec.ts","src/resume/dto/create-resume.dto.spec.ts"],"removed":[],"modified":[".env.example","src/resume/ats-v1/ats-v1.dto.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/ats-v1.service.spec.ts","src/resume/ats-v1/ats-v1.service.ts","src/resume/ats-v1/validation/schema-validator.ts","src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.ts"]},{"id":"190a84b3576702cd79544c966e3e1e739d812c55","tree_id":"25e2f5d8b525b5d317e1308e63b20b390a14c01d","distinct":false,"message":"feat(resume): editable ATS preview hooks and fix-it targets for checks\n\n- The server preview can mark editable text (data-bp) and jump targets (data-jump) so the live\n  preview edits the right builder field. Exports are unchanged (no markers).\n- The mapper records where each mapped row came from (it drops empty bullets, education and\n  certifications), and every issue now carries a builder target {section, index, field}.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T03:52:50-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/190a84b3576702cd79544c966e3e1e739d812c55","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T03:52:50-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T03:52:50-05:00","username":"jobfynder"},"added":["src/resume/ats-v1/validation/issue-target.spec.ts","src/resume/ats-v1/validation/issue-target.ts"],"removed":[],"modified":["src/resume/ats-v1/ats-v1.dto.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/ats-v1.service.ts","src/resume/ats-v1/render/text-html.renderer.ts","src/resume/ats-v1/templates/resume.html.njk","src/resume/resume.controller.ts"]},{"id":"65fd511c8283948866fd1fd97780bb8d131d8493","tree_id":"51ae009a5a59c589f14b40c5a9ed61708a32d6c5","distinct":false,"message":"feat(resume): real-time sharing and live editing\n\n- People sharing by email with viewer / commenter / editor roles, plus edit-level share links.\n- Socket.IO gateway (/resume-collab) relaying a Yjs document, with presence, role pushes and removal.\n- Field-level merge: concurrent edits to different fields, bullets and rows all survive.\n- Sharing endpoints, shared-with-me, and a save route for editors who do not own the resume.\n- Migration adds EDIT, resume_collaborators and resume_collab_docs. Docs in docs/resume/live-collaboration.md.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T03:52:51-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/65fd511c8283948866fd1fd97780bb8d131d8493","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T03:52:51-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T03:52:51-05:00","username":"jobfynder"},"added":["docs/resume/live-collaboration.md","prisma/migrations/20261113100000_resume_live_collaboration/migration.sql","src/collaboration/cors-io.adapter.ts","src/collaboration/dto/access.dto.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-access.service.spec.ts","src/collaboration/resume-access.service.ts","src/collaboration/resume-collab.gateway.ts","src/collaboration/resume-collab.service.spec.ts","src/collaboration/resume-collab.service.ts"],"removed":[],"modified":["package-lock.json","package.json","prisma/schema.prisma","src/collaboration/collaboration.controller.ts","src/collaboration/collaboration.module.ts","src/collaboration/dto/share.dto.ts","src/collaboration/share.service.ts","src/main.ts"]},{"id":"9bf4342a31ba31e578c40f9057145883e1371dc9","tree_id":"d631c165753179c1ac7d212205b74906ff0db7e9","distinct":false,"message":"feat(resume): comments, versions, activity trail, section locks, idle timeout, bullet metrics, job import\n\n- Field-anchored comments with replies and resolve, pushed live to open editors (/field-comments).\n- Named versions with restore (an automatic version is saved first; the live document is reset).\n- Activity trail and per-section last editor; repeated saves coalesce.\n- Owner-only section locks enforced on REST saves and on live updates (scratch-copy probe).\n- Idle connections are closed after RESUME_COLLAB_IDLE_MS (default 30 min).\n- Per-bullet metrics accepted by the ATS mapper.\n- POST /resume/job-source/import for LinkedIn Jobs, Dice and careers pages, guarded against internal addresses.\n- Migration 20261113200000_resume_history_and_locks.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T05:49:01-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/9bf4342a31ba31e578c40f9057145883e1371dc9","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T05:49:01-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T05:49:01-05:00","username":"jobfynder"},"added":["prisma/migrations/20261113200000_resume_history_and_locks/migration.sql","src/collaboration/resume-collab.gateway.spec.ts","src/collaboration/resume-history.service.ts","src/collaboration/resume-sections.spec.ts","src/collaboration/resume-sections.ts","src/resume/job-source/job-source.controller.ts","src/resume/job-source/job-source.service.spec.ts","src/resume/job-source/job-source.service.ts"],"removed":[],"modified":[".env.example","docs/resume/live-collaboration.md","prisma/schema.prisma","src/collaboration/collaboration.module.ts","src/collaboration/comment.service.ts","src/collaboration/dto/access.dto.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-collab.gateway.ts","src/collaboration/resume-collab.service.spec.ts","src/collaboration/resume-collab.service.ts","src/resume/ats-v1/ats-v1.mapper.spec.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/resume.controller.ts","src/resume/resume.module.ts"]},{"id":"f5b3af4bc5134d0f93d30063a98334fa5891295f","tree_id":"46be09e593bd1d4bade9fcfc83cf986f2b79e671","distinct":false,"message":"fix(resume): bullets on import, refuse missing job pages, staging R2 and Hermes tooling\n\n- Hermes import returns each role's duties as one run-on description; split it into bullets\n  (abbreviation-safe) so the builder, ATS checks and bullet metrics have content to work on.\n- Job-link import refuses error pages (\"can't be found\", HTTP ERROR 404, \"doesn't exist\") and\n  near-empty text with a plain 400 instead of analysing them as a job.\n- Add scripts to set up and check the staging R2 buckets (secrets are prompted for and written to\n  .env, never printed), apply quarantine CORS, and point the API at the live Hermes.\n- Document the staging R2 / Hermes runbook and the new import behaviour.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T10:32:38-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/f5b3af4bc5134d0f93d30063a98334fa5891295f","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T10:32:38-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T10:32:38-05:00","username":"jobfynder"},"added":["docs/resume/staging-r2-and-hermes.md","scripts/r2-apply-cors.cjs","scripts/r2-staging-check.cjs","scripts/setup-hermes.ps1","scripts/setup-r2-staging.ps1"],"removed":[],"modified":["docs/resume/live-collaboration.md","src/common/utils/resume.util.spec.ts","src/common/utils/resume.util.ts","src/resume/job-source/job-source.service.spec.ts","src/resume/job-source/job-source.service.ts"]},{"id":"c3e70e13dc61a34c47e07646f4d52dce31096163","tree_id":"ed95e4b561cd74bd8bc1d4b6353c1ca3f1bd6a20","distinct":false,"message":"fix(linkedin): plain message when LinkedIn import is not configured, add token setup script\n\nThe Apify client leaked the setting name (\"APIFY_TOKEN is not configured\") to users of both\nonboarding and the resume builder. Log the detail and return a plain message instead.\nAdd scripts/setup-linkedin-import.ps1, which prompts for the token (hidden) and writes it to .env.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T11:21:37-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/c3e70e13dc61a34c47e07646f4d52dce31096163","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T11:21:37-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T11:21:37-05:00","username":"jobfynder"},"added":["scripts/setup-linkedin-import.ps1"],"removed":[],"modified":["src/linkedin/apify.client.ts"]},{"id":"d830b86f2276a4a83d608c3b9aa7a550795201e9","tree_id":"47c38559d14ca1c8103f2109cbcb9118d3a54588","distinct":false,"message":"fix(resume): security and scale hardening from the PR review (blockers and follow-ups)\n\nBlockers\n- Invites only apply to accounts with a verified email (registration issues a token before verification,\n  so anyone could register an invited address and read the resume).\n- Job import SSRF: one shared address check (IPv4 inside IPv6, NAT64, 6to4, link/unique-local, ports 80/443)\n  used for the URL and again for every request the headless browser makes (redirects, images, scripts).\n- Job import runs on one shared browser (2 pages at once, bounded queue) with a per-user rate limit.\n- Live sockets: sessions and access re-checked every 60 s (sign-out, expired/revoked link, role change);\n  non-owners cannot seed while a section is locked; document size capped (1 MB); per-connection message\n  budget; connection/room caps; read-only roles refused first; room lease table so a second API instance\n  refuses a room another instance owns (new migration resume_collab_leases).\n\nFollow-ups\n- Viewers see names, not emails or account ids (comments, history, document, presence); `mine` flag on comments.\n- UUID validation on every id; production Prisma errors no longer name columns; 413/400 for bad bodies.\n- Share token travels in X-Share-Token and is redacted from request and error logs.\n- Caps and pruning for versions, activity, comments, collaborators; batched activity writes; restore in a\n  transaction; cursor pagination for comments and shared-with-me.\n- PDF render queue cap, per-user render/export limits, 2 MB body limit on rendering/collaboration routes.\n- Persistence every 3 s, bounded lock cache, batched role re-checks, cached handshake lookups, merged presence.\n- Unused variable fix in resume.util; tests for all of the above; docs and .env.example updated.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T14:31:53-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/d830b86f2276a4a83d608c3b9aa7a550795201e9","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T14:31:53-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T14:31:53-05:00","username":"jobfynder"},"added":["prisma/migrations/20261113300000_resume_collab_leases/migration.sql","src/collaboration/comment.service.spec.ts","src/collaboration/resume-history.service.spec.ts","src/collaboration/resume-projections.spec.ts","src/collaboration/resume-projections.ts","src/collaboration/share-token.decorator.ts","src/common/utils/concurrency-limiter.spec.ts","src/common/utils/concurrency-limiter.ts","src/common/utils/public-url.util.spec.ts","src/common/utils/public-url.util.ts","src/common/utils/scrub-url.spec.ts","src/common/utils/scrub-url.ts","src/common/utils/user-rate-limit.ts"],"removed":[],"modified":[".env.example","docs/resume/live-collaboration.md","prisma/schema.prisma","src/app.module.ts","src/collaboration/collaboration.controller.ts","src/collaboration/comment.service.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-access.service.spec.ts","src/collaboration/resume-access.service.ts","src/collaboration/resume-collab.gateway.spec.ts","src/collaboration/resume-collab.gateway.ts","src/collaboration/resume-collab.service.spec.ts","src/collaboration/resume-collab.service.ts","src/collaboration/resume-history.service.ts","src/common/filters/all-exceptions.filter.spec.ts","src/common/filters/all-exceptions.filter.ts","src/common/utils/resume.util.ts","src/common/utils/scraper.util.ts","src/main.ts","src/resume/ats-v1/render/pdf.renderer.ts","src/resume/job-source/job-source.controller.ts","src/resume/job-source/job-source.service.spec.ts","src/resume/job-source/job-source.service.ts","src/resume/resume.controller.ts"]},{"id":"06a42e43832f5de63bfec351b7865c8c0d41438e","tree_id":"a8189fa9083043a15c3eeed6c01ef9681bd1992c","distinct":false,"message":"Resume AI: wire tailor/gaps/cover-letter/headline prompts, output contracts, 429 handling, fair credit prices\n\n- New routes tailor/rewrite, gaps/analyze, cover-letter/generate, headline/suggest with checked output (resume-ai-output)\n- Explicit JSON output contract sent with the three prompts that name no format\n- Hermes 429: retry after Retry-After (capped) and a per-instance limit on concurrent model calls\n- Rule-based features (tailor guidance, quality, skills, match) cost 1 credit; model features keep their price\n- No source_text on the new prompts (asserted in tests); prompt registry check script and docs\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T15:58:00-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/06a42e43832f5de63bfec351b7865c8c0d41438e","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T15:58:00-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T15:58:00-05:00","username":"jobfynder"},"added":["docs/resume/ai-features.md","scripts/hermes-check-prompts.cjs","src/hermes/dto/resume-ai.dto.ts","src/hermes/resume-ai-contracts.ts","src/hermes/resume-ai-output.spec.ts","src/hermes/resume-ai-output.ts"],"removed":[],"modified":[".env.example","src/billing/credits/credit-costs.config.ts","src/config/configuration.ts","src/config/env.validation.ts","src/hermes/hermes-intelligence.service.spec.ts","src/hermes/hermes-intelligence.service.ts","src/hermes/hermes.client.spec.ts","src/hermes/hermes.client.ts","src/resume-intelligence/resume-intelligence.controller.ts"]},{"id":"c74bd64ec083b8230860ae7df71710eb2dad6c74","tree_id":"a33136498b362b8a614cbe401b02aadc840116af","distinct":false,"message":"docs: resume AI output schema now lives in the Langfuse prompts (v2)\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-13T16:53:26-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/c74bd64ec083b8230860ae7df71710eb2dad6c74","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T16:53:26-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-13T16:53:26-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["docs/resume/ai-features.md"]},{"id":"86e90958aff98c7595c99045136fc5f232f48e25","tree_id":"7ab0da609d865377b32df03f254d6257acfa256c","distinct":false,"message":"Resume builder: address architecture review (P0/P1)\n\n- Optimistic concurrency: expectedUpdatedAt on both save endpoints, atomic check+write, 409 on mismatch\n- Deleting a resume closes its live room and removes connected people\n- atsScore no longer client-writable; stored by the quality check from the analysis\n- Linking a document and storing the score no longer move updatedAt\n- GET /resume paginated (limit/cursor); bench-summary grouped in the database\n- Index on users(lower(email)) for collaborator lookups\n- Docs list what is still open (service/envelope refactor, Redis, export-from, JSON validation)\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-14T11:59:28-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/86e90958aff98c7595c99045136fc5f232f48e25","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T11:59:28-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T11:59:28-05:00","username":"jobfynder"},"added":["prisma/migrations/20261114100000_users_lower_email_index/migration.sql","src/resume/resume-save.util.ts"],"removed":[],"modified":["docs/resume/live-collaboration.md","src/collaboration/collaboration.module.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-access.service.ts","src/resume-intelligence/resume-intelligence.controller.spec.ts","src/resume-intelligence/resume-intelligence.controller.ts","src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]},{"id":"09bdaea6b33df656bb0277cecd5326700125c026","tree_id":"fd38e30ae4ffbaee400c7b744843d695bf8b8c4f","distinct":false,"message":"Resume builder: ResumeService + envelope alignment, optional Redis for multi-instance (review P2)\n\n- ResumeService holds the resume rules; ResumeCrudController is the thin HTTP layer on the standard envelope (AppError, ParseUUIDPipe)\n- One shared writable-field list (resume-fields.ts) for owner and collaborator saves\n- Optional Redis (REDIS_URL): rate limits counted across instances (enforceLimit, atomic script, falls back in-process), access/lock/notify events shared on a pub/sub channel\n- Docs: running several instances, sticky routing by resumeId, why no Socket.IO adapter\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-14T12:10:21-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/09bdaea6b33df656bb0277cecd5326700125c026","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T12:10:21-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T12:10:21-05:00","username":"jobfynder"},"added":["src/collaboration/resume-access-events.ts","src/common/redis/redis-limit.store.ts","src/common/redis/redis.module.ts","src/common/redis/redis.service.ts","src/common/redis/redis.spec.ts","src/resume/resume-crud.controller.ts","src/resume/resume-fields.ts","src/resume/resume.service.spec.ts","src/resume/resume.service.ts"],"removed":[],"modified":[".env.example","docs/resume/live-collaboration.md","package-lock.json","package.json","src/app.module.ts","src/collaboration/comment.service.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-access.service.ts","src/collaboration/resume-history.service.ts","src/common/utils/user-rate-limit.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts","src/resume/resume.module.ts"]},{"id":"b74b9120633c97dbfc9a89ecd6fabf81fd25c973","tree_id":"7524c522ed5029cab07f7dfaa2189fa20120b302","distinct":false,"message":"Resume builder: finish review follow-ups (export from saved resume, content validation, shared socket cap, bounded uploads)\n\n- POST /resume/:id/export renders from the stored resume for anyone who may view it, 422 on blocking errors, records the export in activity\n- Save/create validate content shape and size (422 with reasons); unknown keys pass\n- Per-user live-editing socket cap counted across instances via Redis (expiring entries, fails open)\n- PDF/DOCX text extraction bounded (RESUME_PARSE_CONCURRENCY / RESUME_PARSE_MAX_QUEUE, 429 beyond)\n- Docs: worker-queue decision and its trigger\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-14T12:27:48-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/b74b9120633c97dbfc9a89ecd6fabf81fd25c973","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T12:27:48-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-14T12:27:48-05:00","username":"jobfynder"},"added":["src/collaboration/shared-socket-counter.spec.ts","src/collaboration/shared-socket-counter.ts","src/resume/ats-v1/row-to-builder.spec.ts","src/resume/ats-v1/row-to-builder.ts","src/resume/resume-shape.spec.ts","src/resume/resume-shape.ts"],"removed":[],"modified":[".env.example","docs/resume/live-collaboration.md","src/collaboration/collaboration.module.ts","src/collaboration/resume-access.controller.ts","src/collaboration/resume-collab.gateway.ts","src/common/utils/resume.util.spec.ts","src/common/utils/resume.util.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts","src/resume/resume.service.ts"]},{"id":"e581403b3e9f27c32b1ce7cb500cf95534c93940","tree_id":"7524c522ed5029cab07f7dfaa2189fa20120b302","distinct":true,"me