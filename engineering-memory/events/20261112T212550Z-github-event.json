anch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/44b459d86854...19b31084e107","commits":[{"id":"712f84be2c76b32b1dded835b37932d2d85f52c7","tree_id":"bf26bf017add59f5d5d2a3c8a27da71edf964aa1","distinct":true,"message":"fix(resume): stop accepting file uploads on PUT /resume/:id\n\nThe multipart 'template' upload wrote files to local disk (ephemeral, not\nprivate storage) and nothing in the FE or BE used it. Stored files now go only\nthrough the documents module.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-12T16:04:51-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/712f84be2c76b32b1dded835b37932d2d85f52c7","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:04:51-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:04:51-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]},{"id":"9ee4c2179eee1c9599ff9a1df232a925f0b1f30d","tree_id":"78af6e9d97e61d1a80754311aa02f08b9796bf53","distinct":true,"message":"fix(resume): variants inherit the parent's consultantProfileId\n\nA variant created from a bench consultant's resume lost the consultant link,\nso it showed up as the bench user's own resume and was not counted in the\nbench summary. Found by the local end-to-end run.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-12T16:13:37-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/9ee4c2179eee1c9599ff9a1df232a925f0b1f30d","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:13:37-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:13:37-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]},{"id":"19b31084e107db34052d6f2976c0f7622cfa1f84","tree_id":"2fcba545b8c4295e7888ed108b3d08ed20b8fa50","distinct":true,"message":"fix(resume): bench-consultant resumes without an email; bucket policy script\n\n- Creating a resume for a managed consultant failed with 'email must be an\n  email' when the consultant had no email on file, and autosave then failed on\n  PUT with an empty email. The email is now optional for consultant resumes\n  (taken from the consultant when visible) and an empty email is accepted on\n  update. Found by the local role-based end-to-end run.\n- scripts/documents-apply-bucket-policy.ts applies the documented CORS +\n  7-day lifecycle rules to a quarantine bucket (dry run by default).\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-12T16:25:46-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/19b31084e107db34052d6f2976c0f7622cfa1f84","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:25:46-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:25:46-05:00","username":"jobfynder"},"added":["scripts/documents-apply-bucket-policy.ts"],"removed":[],"modified":["src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]}],"head_commit":{"id":"19b31084e107db34052d6f2976c0f7622cfa1f84","tree_id":"2fcba545b8c4295e7888ed108b3d08ed20b8fa50","distinct":true,"message":"fix(resume): bench-consultant resumes without an email; bucket policy script\n\n- Creating a resume for a managed consultant failed with 'email must be an\n  email' when the consultant had no email on file, and autosave then failed on\n  PUT with an empty email. The email is now optional for consultant resumes\n  (taken from the consultant when visible) and an empty email is accepted on\n  update. Found by the local role-based end-to-end run.\n- scripts/documents-apply-bucket-policy.ts applies the documented CORS +\n  7-day lifecycle rules to a quarantine bucket (dry run by default).\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-12T16:25:46-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/19b31084e107db34052d6f2976c0f7622cfa1f84","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:25:46-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-12T16:25:46-05:00","username":"jobfynder"},"added":["scripts/documents-apply-bucket-policy.ts"],"removed":[],"modified":["src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]}}
