{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-09-08T16:34:58Z","pushed_at":1788890165,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":851,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/a745fedce093...d4670bc51598","commits":[{"id":"4402a23ab42c8a0e27e37caf11759f89cdb27ee5","tree_id":"1b84da2abd695172c57d45303460eb399502a34a","distinct":true,"message":"fix(email-parsing): fill job-requirement company from the signature parser before LLM fallback\n\ncompany_missing is the single largest requires_review driver in\nproduction (67% of all review warnings, HERMES-950 review-queue\nreport), because most recruiter emails never label \"Company:\"\nexplicitly. Hermes already extracts this deterministically via the\nsignature-block parser (100% precision, 32% fill rate across all\ndrafts) but that value was never wired into the job-requirement\nrecord's own company field, which the 0.70 confidence gate actually\nlooks at -- so a value Hermes had already found kept getting sent to\nreview anyway.\n\napply_signature_company_fill() (app/email_parsing/parsers.py) closes\nthat gap: only fills company when it's genuinely empty, never\noverrides a deterministic hit, and is restricted to the single-job\ncase (same reasoning apply_job_requirement_fallback already uses for\nmulti-position emails). It runs before the LLM fallback in\napp/channels/service.py so a successful fill can push confidence\nabove threshold and skip the LLM call entirely -- deterministic\nsignals resolve the gap first, LLM stays a genuine last resort given\nthis traffic volume and its cost.\n\nAdds scripts/hermes-850-signature-company-fill-check.py (wired into\nthe CI regression suite) covering the fill, the never-overrides\nguarantee, the multi-position exclusion, and that a resolvable case\nnever reaches the mocked LLM call.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T23:26:04+05:30","url":"https://github.com/jobfynder/hermes/commit/4402a23ab42c8a0e27e37caf11759f89cdb27ee5","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:40:11-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T23:26:04+05:30","username":"jobfynder"},"added":["scripts/hermes-850-signature-company-fill-check.py"],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/channels/service.py","app/email_parsing/parsers.py","app/email_parsing/provenance.py"]},{"id":"f4ae54c2df239876e5ac421a89b6c1cca8afbd4f","tree_id":"9f65ea87630d81c8fcb20dd0baf7a1164fb17ca7","distinct":true,"message":"fix(ci): make hermes-runtime storage root env-configurable so CI can actually run\n\nEvery regression-suite CI run on main has been failing at import time\nfor at least the last 5 pushes (2026-09-02 onward), unrelated to any\nspecific change: app/runtime/jsonl_store.py hardcoded\nRUNTIME_ROOT = Path(\"/hermes-runtime\"), a path that only exists via\nthe real deployment's Docker volume, not on the GitHub Actions\nrunner's root filesystem. Every check script pulls this in\ntransitively (app.channels.service -> app.access.service ->\napp.runtime.events), so the suite never got past the first import.\n\nSame fix pattern already used elsewhere in this codebase\n(HERMES_ACCESS_CONTROL_FILE, HERMES_TAXONOMY_RUNTIME_DIR,\nHERMES_PROMPT_RUN_LOG_DIR): read the root from an env var with the\nsame default, so production behavior is unchanged, and point CI at\nthe runner's own writable temp dir instead.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T23:26:04+05:30","url":"https://github.com/jobfynder/hermes/commit/f4ae54c2df239876e5ac421a89b6c1cca8afbd4f","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:48:24-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T23:26:04+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/runtime/jsonl_store.py"]},{"id":"d4670bc5159854c2258a8ce206b5db6142036606","tree_id":"a172b1b50b567de313b88b383289d2f18f848d7a","distinct":true,"message":"fix(ci): use a literal temp path, not the unavailable runner context\n\nThe runner context isn't valid inside jobs.<job_id>.env (only github,\nneeds, vars, strategy, matrix, secrets, inputs are) -- using\nrunner.temp there made GitHub reject the whole workflow file before a\nsingle job could even start. A plain /tmp path needs no context at\nall and is writable on every GitHub-hosted runner.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T23:26:04+05:30","url":"https://github.com/jobfynder/hermes/commit/d4670bc5159854c2258a8ce206b5db6142036606","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:49:57-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T23:26:04+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":[".github/workflows/hermes-regression.yml"]}],"head_commit":{"id":"d4670bc5159854c2258a8ce206b5db6142036606","tree_id":"a172b1b50b567de313b88b383289d2f18f848d7a","distinct":true,"message":"fix(ci): use a literal temp path, not the unavailable runner context\n\nThe runner context isn't valid inside jobs.<job_id>.env (only github,\nneeds, vars, strategy, matrix, secrets, inputs are) -- using\nrunner.temp there made GitHub reject the whole workflow file before a\nsingle job could even start. A plain /tmp path needs no context at\nall and is writable on every GitHub-hosted runner.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T23:26:04+05:30","url":"https://github.com/jobfynder/hermes/commit/d4670bc5159854c2258a8ce206b5db6142036606","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:49:57-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T23:26:04+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":[".github/workflows/hermes-regression.yml"]}}
