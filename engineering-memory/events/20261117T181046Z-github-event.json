\n  prefixes\n- unit tests for the guard, ownership check and folder allowlist\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-17T13:05:57-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/4bcfbe31c2bb03f9d987183ee6e5507d390be8ae","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-10-29T04:56:19-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T13:05:57-05:00","username":"jobfynder"},"added":["src/storage/storage-access.service.ts"],"removed":[],"modified":["src/storage/dto/upload-url.dto.ts","src/storage/resume-key.spec.ts","src/storage/resume-key.ts","src/storage/storage.controller.spec.ts","src/storage/storage.controller.ts","src/storage/storage.module.ts"]},{"id":"91d1d364f25f27d374bf2ba482927958ff8ea451","tree_id":"befc9c0b498c02edab386a5829be4759f1a58606","distinct":true,"message":"fix(storage): shared folders, folder allowlist matching the apps, consultant resumes never served\n\nCombines the earlier owner-only fix with what the frontend does today:\nMessenger attachments (messenger/) and profile photos are shared folders,\nresumes/ is an allowed upload folder, and a key referenced by a managed\nconsultant profile is never downloadable here.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-17T13:10:38-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/91d1d364f25f27d374bf2ba482927958ff8ea451","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T13:10:38-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T13:10:38-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["docs/STORAGE-ROUTES-HARDENING.md","src/storage/resume-key.spec.ts","src/storage/storage-access.service.ts"]}],"head_commit":{"id":"91d1d364f25f27d374bf2ba482927958ff8ea451","tree_id":"befc9c0b498c02edab386a5829be4759f1a58606","distinct":true,"message":"fix(storage): shared folders, folder allowlist matching the apps, consultant resumes never served\n\nCombines the earlier owner-only fix with what the frontend does today:\nMessenger attachments (messenger/) and profile photos are shared folders,\nresumes/ is an allowed upload folder, and a key referenced by a managed\nconsultant profile is never downloadable here.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-17T13:10:38-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/91d1d364f25f27d374bf2ba482927958ff8ea451","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T13:10:38-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T13:10:38-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["docs/STORAGE-ROUTES-HARDENING.md","src/storage/resume-key.spec.ts","src/storage/storage-access.service.ts"]}}
