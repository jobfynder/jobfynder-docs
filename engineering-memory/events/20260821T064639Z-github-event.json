hub.com/repos/jobfynder/hermes/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-07-14T14:57:49Z","pushed_at":1787294794,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":339,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":2,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":true,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/commit/3f3de0796c82","commits":[{"id":"3f3de0796c82a5173195af4580a7bf585e0fdfe6","tree_id":"1aeeaf98ba65ec45d139dd6023759ce106dec8a5","distinct":true,"message":"perf(hermes-750): fetch Langfuse prompt details concurrently instead of sequentially\n\napp/prompt_runtime/langfuse_prompts.py _refresh_cache() fetched all 38\nprompts one HTTP round-trip at a time (N+1 pattern) - measured at ~33s on\na cold cache before this fix. The cache lasts 5 minutes, so this only hit\nthe first request after expiry, but that request could fail for any\ncaller with a normal 10-30s timeout even though the fetch would have\nsucceeded given more time.\n\nFixed with a ThreadPoolExecutor (stdlib, no new dependency) fetching\nprompt details in parallel, default concurrency 8, tunable via\nHERMES_LANGFUSE_PROMPT_FETCH_CONCURRENCY without a redeploy. A single\nfailed detail fetch still only drops that one prompt from the registry,\nsame as before - it never aborts the whole refresh.\n\nVerified against the live Langfuse instance: 33.59s -> 7.55s for the same\n38 prompts, correct prompt_count both times. New check script covers\ncorrectness+timing, that one simulated failure does not abort the batch,\nand the env-var concurrency setting (including invalid-value fallback and\nclamping to a minimum of 1).\n\nFull regression: HERMES-400 and HERMES-850 checks unaffected. The three\npre-existing HERMES-750/800 check failures (stale Langfuse prompt IDs\nfrom the earlier Portkey-era registry, documented separately in\nHERMES-750-litellm-prompt-runtime-foundation.md) are unchanged by this\nfix - not a new regression.","timestamp":"2026-08-21T02:46:25-04:00","url":"https://github.com/jobfynder/hermes/commit/3f3de0796c82a5173195af4580a7bf585e0fdfe6","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-21T02:46:25-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-21T02:46:25-04:00"},"added":["scripts/hermes-750-langfuse-concurrent-fetch-check.py"],"removed":[],"modified":[".env.example","app/prompt_runtime/langfuse_prompts.py"]}],"head_commit":{"id":"3f3de0796c82a5173195af4580a7bf585e0fdfe6","tree_id":"1aeeaf98ba65ec45d139dd6023759ce106dec8a5","distinct":true,"message":"perf(hermes-750): fetch Langfuse prompt details concurrently instead of sequentially\n\napp/prompt_runtime/langfuse_prompts.py _refresh_cache() fetched all 38\nprompts one HTTP round-trip at a time (N+1 pattern) - measured at ~33s on\na cold cache before this fix. The cache lasts 5 minutes, so this only hit\nthe first request after expiry, but that request could fail for any\ncaller with a normal 10-30s timeout even though the fetch would have\nsucceeded given more time.\n\nFixed with a ThreadPoolExecutor (stdlib, no new dependency) fetching\nprompt details in parallel, default concurrency 8, tunable via\nHERMES_LANGFUSE_PROMPT_FETCH_CONCURRENCY without a redeploy. A single\nfailed detail fetch still only drops that one prompt from the registry,\nsame as before - it never aborts the whole refresh.\n\nVerified against the live Langfuse instance: 33.59s -> 7.55s for the same\n38 prompts, correct prompt_count both times. New check script covers\ncorrectness+timing, that one simulated failure does not abort the batch,\nand the env-var concurrency setting (including invalid-value fallback and\nclamping to a minimum of 1).\n\nFull regression: HERMES-400 and HERMES-850 checks unaffected. The three\npre-existing HERMES-750/800 check failures (stale Langfuse prompt IDs\nfrom the earlier Portkey-era registry, documented separately in\nHERMES-750-litellm-prompt-runtime-foundation.md) are unchanged by this\nfix - not a new regression.","timestamp":"2026-08-21T02:46:25-04:00","url":"https://github.com/jobfynder/hermes/commit/3f3de0796c82a5173195af4580a7bf585e0fdfe6","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-21T02:46:25-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-21T02:46:25-04:00"},"added":["scripts/hermes-750-langfuse-concurrent-fetch-check.py"],"removed":[],"modified":[".env.example","app/prompt_runtime/langfuse_prompts.py"]}}
