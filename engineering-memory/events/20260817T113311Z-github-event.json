argazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/67e1cfc7383a...ba91cb35e412","commits":[{"id":"ba91cb35e412b7d69c46bd6085d89b275b160960","tree_id":"e5461afdd17b3a410da72c17f8d3457482f7f6eb","distinct":true,"message":"Wire logProfileView() into ProfileService; test the mutual-exchange rule\n\nProfile views were computing the anti-noise rule correctly in\nlogProfileView() but nothing ever called it - getProfileDetailsByViewer()\nhad no path to the Network module. Wired it in fire-and-forget (a profile\nview is a weak background signal, not worth delaying a real page load for),\nguarded against self-views and anonymous viewers, with a .catch() safety\nnet since the existence-check query isn't self-guarded the way\nlogRelationshipEvent() is.\n\nAlso adds direct unit tests for maybeLogMutualExchange() covering both\nanti-noise branches (one-way conversation logs nothing; a real reply logs\nMESSAGE_EXCHANGE_MUTUAL exactly once), which previously had only a stubbed\nmock with no assertions.\n\nRecords Decision 7 in the reconciliation doc: six spec triggers\n(application, interview scheduled/completed, offer extended, resume share,\nreferral, service request/completed) have no underlying feature to wire to\nyet, so a future session doesn't guess at mapping them onto whatever module\nlooks closest.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-17T07:32:54-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/ba91cb35e412b7d69c46bd6085d89b275b160960","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-17T07:32:54-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-17T07:32:54-04:00","username":"jobfynder"},"added":[],"removed":[],"modified":["docs/10-reconciliation-decisions.md","src/messenger/messenger.service.spec.ts","src/profile/profile.module.ts","src/profile/profile.service.ts"]}],"head_commit":{"id":"ba91cb35e412b7d69c46bd6085d89b275b160960","tree_id":"e5461afdd17b3a410da72c17f8d3457482f7f6eb","distinct":true,"message":"Wire logProfileView() into ProfileService; test the mutual-exchange rule\n\nProfile views were computing the anti-noise rule correctly in\nlogProfileView() but nothing ever called it - getProfileDetailsByViewer()\nhad no path to the Network module. Wired it in fire-and-forget (a profile\nview is a weak background signal, not worth delaying a real page load for),\nguarded against self-views and anonymous viewers, with a .catch() safety\nnet since the existence-check query isn't self-guarded the way\nlogRelationshipEvent() is.\n\nAlso adds direct unit tests for maybeLogMutualExchange() covering both\nanti-noise branches (one-way conversation logs nothing; a real reply logs\nMESSAGE_EXCHANGE_MUTUAL exactly once), which previously had only a stubbed\nmock with no assertions.\n\nRecords Decision 7 in the reconciliation doc: six spec triggers\n(application, interview scheduled/completed, offer extended, resume share,\nreferral, service request/completed) have no underlying feature to wire to\nyet, so a future session doesn't guess at mapping them onto whatever module\nlooks closest.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-17T07:32:54-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/ba91cb35e412b7d69c46bd6085d89b275b160960","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-17T07:32:54-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-17T07:32:54-04:00","username":"jobfynder"},"added":[],"removed":[],"modified":["docs/10-reconciliation-decisions.md","src/messenger/messenger.service.spec.ts","src/profile/profile.module.ts","src/profile/profile.service.ts"]}}
