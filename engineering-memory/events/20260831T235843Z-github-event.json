argazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/116cd58b6d08...fba20c3e9d19","commits":[{"id":"fba20c3e9d196c1897421680187a0fb449ae2a59","tree_id":"e24683e65a903848afb9632aaa361dad4edc7546","distinct":true,"message":"Add n8n auth guard and machine-facing API surface\n\nn8n is real and already running (n8n.jobfynder.com / connect.jobfynder.com,\nconfirmed via docker-compose.yml on the live server) but had no way to\ncall into Core: every /integration-studio/* endpoint required a human\nJWT session. n8n isn't a user, so it gets its own controller instead of\na workaround bolted onto the human-facing one.\n\n- N8nAuthGuard: shared-secret bearer token (N8N_SERVICE_TOKEN),\n  constant-time comparison via crypto.timingSafeEqual. Deliberately a\n  separate secret from HERMES_SERVICE_TOKEN - different trust boundary,\n  one compromised token shouldn't grant the other's access.\n- N8nIntegrationController: GET .../n8n/connections/:id/automations and\n  POST .../n8n/connections/:id/sync, addressed directly by connectionId\n  since there's no ownerId to derive from a session. Both call the exact\n  same service methods (sync-runner.service.ts) the human-facing\n  endpoints use - one execution path, not two.\n\nDoes not close the full loop: Core firing a webhook to n8n when a sync\ncreates a Job (so n8n can run an automation's THEN step) isn't built,\nand that step still depends on COMM-1's outbound notify endpoint, which\nalso doesn't exist yet. Documented honestly in\nCORE-600-integration-studio.md Sec7a rather than implied as done.\n\n19/19 tests pass across the module.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-31T19:58:27-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/fba20c3e9d196c1897421680187a0fb449ae2a59","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T19:58:27-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T19:58:27-04:00","username":"jobfynder"},"added":["src/integration-studio/guards/n8n-auth.guard.spec.ts","src/integration-studio/guards/n8n-auth.guard.ts","src/integration-studio/n8n-integration.controller.ts"],"removed":[],"modified":[".env.example","docs/integration-studio/CORE-600-integration-studio.md","src/integration-studio/integration-studio.module.ts","src/integration-studio/integration-studio.service.ts"]}],"head_commit":{"id":"fba20c3e9d196c1897421680187a0fb449ae2a59","tree_id":"e24683e65a903848afb9632aaa361dad4edc7546","distinct":true,"message":"Add n8n auth guard and machine-facing API surface\n\nn8n is real and already running (n8n.jobfynder.com / connect.jobfynder.com,\nconfirmed via docker-compose.yml on the live server) but had no way to\ncall into Core: every /integration-studio/* endpoint required a human\nJWT session. n8n isn't a user, so it gets its own controller instead of\na workaround bolted onto the human-facing one.\n\n- N8nAuthGuard: shared-secret bearer token (N8N_SERVICE_TOKEN),\n  constant-time comparison via crypto.timingSafeEqual. Deliberately a\n  separate secret from HERMES_SERVICE_TOKEN - different trust boundary,\n  one compromised token shouldn't grant the other's access.\n- N8nIntegrationController: GET .../n8n/connections/:id/automations and\n  POST .../n8n/connections/:id/sync, addressed directly by connectionId\n  since there's no ownerId to derive from a session. Both call the exact\n  same service methods (sync-runner.service.ts) the human-facing\n  endpoints use - one execution path, not two.\n\nDoes not close the full loop: Core firing a webhook to n8n when a sync\ncreates a Job (so n8n can run an automation's THEN step) isn't built,\nand that step still depends on COMM-1's outbound notify endpoint, which\nalso doesn't exist yet. Documented honestly in\nCORE-600-integration-studio.md Sec7a rather than implied as done.\n\n19/19 tests pass across the module.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-31T19:58:27-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/fba20c3e9d196c1897421680187a0fb449ae2a59","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T19:58:27-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T19:58:27-04:00","username":"jobfynder"},"added":["src/integration-studio/guards/n8n-auth.guard.spec.ts","src/integration-studio/guards/n8n-auth.guard.ts","src/integration-studio/n8n-integration.controller.ts"],"removed":[],"modified":[".env.example","docs/integration-studio/CORE-600-integration-studio.md","src/integration-studio/integration-studio.module.ts","src/integration-studio/integration-studio.service.ts"]}}
