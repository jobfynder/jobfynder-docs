rgazers":0,"master_branch":"main"},"pusher":{"name":"atult120","email":"atult120@gmail.com"},"forced":false,"sender":{"login":"atult120","id":29686038,"node_id":"MDQ6VXNlcjI5Njg2MDM4","avatar_url":"https://avatars.githubusercontent.com/u/29686038?v=4","gravatar_id":"","url":"https://api.github.com/users/atult120","html_url":"https://github.com/atult120","followers_url":"https://api.github.com/users/atult120/followers","following_url":"https://api.github.com/users/atult120/following{/other_user}","gists_url":"https://api.github.com/users/atult120/gists{/gist_id}","starred_url":"https://api.github.com/users/atult120/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atult120/subscriptions","organizations_url":"https://api.github.com/users/atult120/orgs","repos_url":"https://api.github.com/users/atult120/repos","events_url":"https://api.github.com/users/atult120/events{/privacy}","received_events_url":"https://api.github.com/users/atult120/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/30b26454ac86...c993b287d3b7","commits":[{"id":"d73beb0bdfd4a53600556806d6f0dbe785db9eb8","tree_id":"cb5d03da4fecdb58c2747468be1135b82513348a","distinct":false,"message":"fix(resume): AI calls fail fast with a clear message; ATS template formatting, spacing and page limit\n\n- AI model calls: one bounded 40 s attempt, no retry of a timeout, short queue wait, and a circuit breaker (fail at once for 45 s after 2 upstream failures) so a down LiteLLM gateway no longer hangs requests past the proxy limit (browser saw 'Failed to fetch')\n- ATS template: no stray separators in the contact line, no empty section headings, section markers for highlighting, roomier spacing\n- maxPages (1-4) overrides the length profile on measure/export/export-from\n- Resume create accepts a label (master resume)\n\nCo-Authored-By: Claude Sonn