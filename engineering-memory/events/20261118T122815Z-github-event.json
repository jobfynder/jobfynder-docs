"email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T13:22:48-05:00","username":"jobfynder"},"added":["src/resume/resume-import.controller.spec.ts","src/resume/resume-import.controller.ts"],"removed":[],"modified":["src/resume/dto/create-resume.dto.ts","src/resume/resume.module.ts","src/resume/resume.service.spec.ts","src/resume/resume.service.ts"]},{"id":"472da7c929286c5d994aed2d551cc8af21c0fc20","tree_id":"21e7eba8fa83afc35f50b08d886da62fe31fa402","distinct":false,"message":"feat(resume): page limits up to 8, richer certifications in the file, credential and readability checks\n\n- maxPages accepts 1-8 (advisory above 4: recruiters read the first two pages closely)\n- Certifications carry expiry, credential ID and a plain-text verification link in the PDF/Word/text exports (no images, which ATS skip)\n- New checks: expired credential, missing issuer or date, too many bullets for a role, no LinkedIn address\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-16T13:55:26-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/472da7c929286c5d994aed2d551cc8af21c0fc20","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T13:55:26-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T13:55:26-05:00","username":"jobfynder"},"added":["src/resume/ats-v1/validation/credentials.spec.ts"],"removed":[],"modified":["src/resume/ats-v1/ats-v1.dto.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/render/docx.renderer.ts","src/resume/ats-v1/row-to-builder.ts","src/resume/ats-v1/schema/resume.schema.json","src/resume/ats-v1/schema/resume.types.ts","src/resume/ats-v1/templates/resume.html.njk","src/resume/ats-v1/templates/resume.txt.njk","src/resume/ats-v1/validation/issue-target.ts","src/resume/ats-v1/validation/lint.rules.ts","src/resume/resume.controller.ts"]},{"id":"cf6bd9126d52a18102dc6f5f11d3418f65e008b8","tree_id":"c2d5a681e42bc1e45d88fba42d3ba4e35f309b95","distinct":false,"message":"Certification catalog (LLM-enriched, usage-ranked, generated badges) and page layout customization\n\n- certification_catalog table, seed, search/choice/logo endpoints, Hermes enrichment prompt\n- layout: section order, hidden sections, spacing, text size across html/txt/docx renderers\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-16T16:59:33-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/cf6bd9126d52a18102dc6f5f11d3418f65e008b8","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T16:59:33-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T16:59:33-05:00","username":"jobfynder"},"added":["prisma/migrations/20261116200000_certification_catalog/migration.sql","scripts/langfuse-certification-enrich-prompt.py","src/certifications/certification-badge.ts","src/certifications/certification-catalog.controller.ts","src/certifications/certification-catalog.service.ts","src/certifications/certification-catalog.spec.ts","src/certifications/certification-enrichment.service.ts","src/certifications/certification-seed.ts","src/certifications/certifications.module.ts","src/resume/ats-v1/render/layout.spec.ts"],"removed":[],"modified":["prisma/schema.prisma","src/app.module.ts","src/config/configuration.ts","src/config/env.validation.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/render/docx.renderer.ts","src/resume/ats-v1/render/text-html.renderer.ts","src/resume/ats-v1/row-to-builder.ts","src/resume/ats-v1/schema/resume.schema.json","src/resume/ats-v1/schema/resume.types.ts","src/resume/ats-v1/templates/resume.html.njk","src/resume/ats-v1/templates/resume.txt.njk"]},{"id":"338a241bb8cfbe08d6aad45c94759d4403b1d35e","tree_id":"a92fb9de936d45aa74ed84bc5c5c90ecbd218e32","distinct":false,"message":"Employers can create consultant resumes and assign them to bench-sales recruiters\n\n- ManagedResumeAccessGuard: employer must be an active org member with permission when a request is about a managed consultant\n- resume create/list/summary/achievements accept employers (org-scoped via the consultants module)\n- POST /resume/:id/assign-recruiter: edit access for a recruiter already assigned to the consultant\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-16T17:20:51-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/338a241bb8cfbe08d6aad45c94759d4403b1d35e","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T17:20:51-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T17:20:51-05:00","username":"jobfynder"},"added":["src/resume/dto/assign-recruiter.dto.ts","src/resume/employer-resume.spec.ts","src/resume/managed-resume-access.guard.ts"],"removed":[],"modified":["src/resume/resume-achievements.controller.ts","src/resume/resume-achievements.service.ts","src/resume/resume-crud.controller.ts","src/resume/resume.module.ts","src/resume/resume.service.ts"]},{"id":"601c374488a1e82bad2052331508151e246e74ad","tree_id":"1f78a5ccbfa8abd6fea069316f68b87e9a648756","distinct":false,"message":"Employers: import a resume file for a consultant; summary counts all of the organization's consultant resumes\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-16T17:29:26-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/601c374488a1e82bad2052331508151e246e74ad","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T17:29:26-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-16T17:29:26-05:00","username":"jobfynder"},"added":[],"removed":[],"modified":["src/resume/employer-resume.spec.ts","src/resume/resume-crud.controller.ts","src/resume/resume-import.controller.spec.ts","src/resume/resume-import.controller.ts","src/resume/resume.service.ts"]},{"id":"e7bb43b0e9c83c4f0ac8f142126c4f905c4fe2f6","tree_id":"c1c7c2d995057e281487d6a48fc601fbf11ff072","distinct":false,"message":"Remove the Langfuse prompt script: prompt ownership belongs to the Hermes repo\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-17T12:31:08-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/e7bb43b0e9c83c4f0ac8f142126c4f905c4fe2f6","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T12:31:08-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-17T12:31:08-05:00","username":"jobfynder"},"added":[],"removed":["scripts/langfuse-certification-enrich-prompt.py"],"modified":[]},{"id":"b8e533170441255a3ebb42a29cebbc581da27036","tree_id":"723542937a3306c1b8af6d40ee7ac08b68cccc53","distinct":false,"message":"Address PR review: catalog integrity, SQL search, opt-in interactive AI mode, assignment hardening\n\nCertification catalog\n- Count distinct people (certification_choice, unique per person and entry), so one user can no longer make an\n  entry public or trigger enrichment (H1, D6).\n- Atomic upsert and increment inside one transaction; no lost counts, no P2002 500 (H2, H3).\n- Enrichment re-keys the slug and merges into an existing entry instead of duplicating it (H4); a lease column\n  makes one request enrich an entry at a time (A5).\n- Search filters in SQL on a normalised search column (H6); the badge is drawn on request, so badgeSvg is dropped (D2).\n- Hashed slug (D5), CHECK constraints for status/source (D1), NOT NULL aliases (D4), better indexes (D3), DTOs (C1, C2),\n  badge marks skip filler words (C11).\n\nHermes\n- Interactive mode (40 s timeout, no timeout retry, shared breaker, 20 s queue wait) is opt-in per call; background\n  callers keep the old behaviour and cannot trip the breaker (H5).\n\nEmployers and assignment\n- Index on resumes.consultantProfileId and a joined summary query instead of an unbounded IN list (M1, M2).\n- Assignment has its own rate-limit budget and skips the repeated owner lookups (M6, M7); access is re-checked after the\n  write and undone if the assignment vanished; assignment access is tagged and removed when the recruiter is\n  unassigned (M5).\n- File uploads from employers always resolve the organization in the guard (M10); import uses the standard error\n  envelope (M9); cheap role check runs first (C6); typed request/actor (C5), comments and title fallback (C3, C7, C8).\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-18T06:09:57-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/b8e533170441255a3ebb42a29cebbc581da27036","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-18T06:09:57-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-18T06:09:57-05:00","username":"jobfynder"},"added":["prisma/migrations/20261118100000_certification_catalog_hardening/migration.sql","src/certifications/dto/certification-choice.dto.ts","src/certifications/dto/search-catalog-query.dto.ts"],"removed":[],"modified":["prisma/schema.prisma","src/certifications/certification-catalog.controller.ts","src/certifications/certification-catalog.service.ts","src/certifications/certification-catalog.spec.ts","src/collaboration/resume-access.service.ts","src/common/utils/concurrency-limiter.ts","src/consultants/consultants.service.spec.ts","src/consultants/consultants.service.ts","src/hermes/hermes-intelligence.service.ts","src/hermes/hermes.client.spec.ts","src/hermes/hermes.client.ts","src/resume/ats-v1/ats-v1.service.ts","src/resume/ats-v1/validation/lint.rules.ts","src/resume/employer-resume.spec.ts","src/resume/managed-resume-access.guard.ts","src/resume/resume-crud.controller.ts","src/resume/resume-import.controller.spec.ts","src/resume/resume-import.controller.ts","src/resume/resume.service.ts"]},{"id":"6b5449b6c8934b1f9d6e2cf0d63039885153e054","tree_id":"4363484e7ce08ce27d30b5bc5d13fcb574ab6e2d","distinct":false,"message":"Close the deferred review items: org-level resume access, moderation, sweeper, shared breaker, service split\n\n- A1/M3/M4: a member of the employer organization that manages a consultant (active, with bench:edit or owner) acts\n  as owner of that consultant's resumes whoever made them: roleFor, collaborator management, getOwned, assign. The\n  employer's list and the summary now count the same set. Answers are cached for 15 s.\n- A2: access handed over by an assignment only counts while the recruiter still represents the consultant (checked\n  at read time, so it cannot outlive the assignment even without the unassign hook).\n- A5/D8: claim lease + a sweeper (every 10 min) retries entries whose enrichment never finished; unrecognised entries\n  nobody chose for 90 days are removed daily.\n- A6/A7: admin API (crm_admin) to review, correct, hide, merge and delete catalogue entries and to remove one\n  person's choices; new 'hidden' status and a review queue (model-verified entries from people, not yet reviewed).\n- D7: seed certifications are loaded by a generated migration, not at application start-up\n  (scripts/gen-certification-seed-migration.ts).\n- M11: when one instance opens the Hermes breaker it sets a shared flag (Redis), so the others fail fast too.\n- M8/C9: one shared file-reading pipeline for onboarding and the builder's import; ResumeService split into\n  ResumeService, ConsultantResumeService (summary, assign) and ResumeImportService.\n- C4: layout options in one module, with a test that the JSON schema lists the same values.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-18T06:34:31-05:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/6b5449b6c8934b1f9d6e2cf0d63039885153e054","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-18T06:34:31-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-18T06:34:31-05:00","username":"jobfynder"},"added":["prisma/migrations/20261118200000_certification_admin_review/migration.sql","prisma/migrations/20261118300000_certification_seed/migration.sql","scripts/gen-certification-seed-migration.ts","src/certifications/certification-admin.controller.ts","src/certifications/certification-admin.service.ts","src/certifications/certification-admin.spec.ts","src/certifications/certification-maintenance.service.ts","src/certifications/dto/certification-admin.dto.ts","src/collaboration/resume-access.org.spec.ts","src/resume/ats-v1/schema/layout-options.spec.ts","src/resume/ats-v1/schema/layout-options.ts","src/resume/consultant-resume.service.ts","src/resume/resume-file-reader.ts","src/resume/resume-import.service.ts"],"removed":[],"modified":["prisma/schema.prisma","src/certifications/certification-catalog.service.ts","src/certifications/certification-catalog.spec.ts","src/certifications/certifications.module.ts","src/collaboration/resume-access.service.ts","src/common/redis/redis-limit.store.ts","src/common/utils/user-rate-limit.ts","src/hermes/hermes.client.spec.ts","src/hermes/hermes.client.ts","src/resume/ats-v1/ats-v1.mapper.ts","src/resume/ats-v1/render/text-html.renderer.ts","src/resume/ats-v1/schema/resume.types.ts","src/resume/employer-resume.spec.ts","src/resume/resume-crud.controller.ts","src/resume/resume-import.controller.ts","src/resume/resume.controller.ts","src/resume/resume.module.ts","src/resum