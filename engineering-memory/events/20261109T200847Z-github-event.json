s_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/7ff7ef0d0d47...2e677d9f1895","commits":[{"id":"e68333be1b0ad0a6e4071573bd4b2492e62bd720","tree_id":"c21f9f7d78804b9b8b65fbdc537431bdf607bb21","distinct":false,"message":"Fix slow dashboard and unsaved edits; fill employment type from more places\n\nSlow dashboard: GET /drafts/review/today ran a 42s table scan on every load,\nstarving the 10-connection pool so every other request (including saving an\nedit) queued behind it. The pipeline query now extracts each record once\n(LATERAL), 42s -> 2.6s, and the heavy Today sections are served stale-while-\nrevalidate so a page load never waits on them.\n\nUnsaved edits: the edit endpoint accepted only 10 fields and silently dropped\nthe rest while the UI still said \"Saved.\" Work mode, duration, start date,\nrequisition id and rate range are now editable, and an edit that would change\nnothing is rejected with a clear error.\n\nEmployment type: new text evidence (subject/body keywords with negation\nhandling, glued labels, delimiter-style \"|| Contract ||\", duration windows,\nhourly rate / salary) at 97-98% agreement with stated values on production,\nplus a sender-history prior (learned only from STATED values, fill-only,\nnever overrides human edits, flagged sender_history, kill switch).\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","timestamp":"2026-11-09T15:06:22-05:00","url":"https://github.com/jobfynder/hermes/commit/e68333be1b0ad0a6e4071573bd4b2492e62bd720","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-09T15:06:22-05:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-09T15:06:22-05:00","username":"jobfynder"},"added":["app/drafts/employment_priors.py","tests/test_employment_inference.py"],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/drafts/pipeline.py","app/drafts/service.py","app/drafts/workbench.py","app/email_parsing/job_fields.py","app/integrations/core_outbox.py","app/runtime/db.py","frontend/src/pages/DraftDetailPage.tsx","frontend/src/types.ts"]},{"id":"2e677d9f189522618b0a4486ea4e7cd886bb602c","tree_id":"c21f9f7d78804b9b8b65fbdc537431bdf607bb21","distinct":true,"message":"Merge pull request #31 from jobfynder/fix/dashboard-speed-edits\n\nFix slow dashboard + unsaved edits; fill employment type from more places","timestamp":"2026-11-10T01:38:40+05:30","url":"https://github.com/jobfynder/hermes/commit/2e677d9f189522618b0a4486ea4e7cd886bb602c","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-10T01:38:40+05:30","username":"jobfynder"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-10T01:38:40+05:30","username":"web-flow"},"added":["app/drafts/employment_priors.py","tests/test_employment_inference.py"],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/drafts/pipeline.py","app/drafts/service.py","app/drafts/workbench.py","app/email_parsing/job_fields.py","app/integrations/core_outbox.py","app/runtime/db.py","frontend/src/pages/DraftDetailPage.tsx","frontend/src/types.ts"]}],"head_commit":{"id":"2e677d9f189522618b0a4486ea4e7cd886bb602c","tree_id":"c21f9f7d78804b9b8b65fbdc537431bdf607bb21","distinct":true,"message":"Merge pull request #31 from jobfynder/fix/dashboard-speed-edits\n\nFix slow dashboard + unsaved edits; fill employment type from more places","timestamp":"2026-11-10T01:38:40+05:30","url":"https://github.com/jobfynder/hermes/commit/2e677d9f189522618b0a4486ea4e7cd886bb602c","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-11-10T01:38:40+05:30",