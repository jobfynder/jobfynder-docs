l":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/compare/{base}...{head}","merges_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/merges","archive_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/downloads","issues_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/issues{/number}","pulls_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/pulls{/number}","milestones_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/milestones{/number}","notifications_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder-admin/jobFynder-BE-nestJS/deployments","created_at":1781544622,"updated_at":"2026-08-31T17:05:27Z","pushed_at":1788221705,"git_url":"git://github.com/jobfynder-admin/jobFynder-BE-nestJS.git","ssh_url":"git@github.com:jobfynder-admin/jobFynder-BE-nestJS.git","clone_url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS.git","svn_url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS","homepage":null,"size":9010,"stargazers_count":0,"watchers_count":0,"language":"TypeScript","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":7,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"private","forks":0,"open_issues":7,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/fba20c3e9d19...7733a596e6f8","commits":[{"id":"7733a596e6f835044be6011a6e6d2203de27424c","tree_id":"5dc5e29c4d59c3b5bfecfd6dff6c42d9c34d59da","distinct":true,"message":"Add Core -> n8n webhook trigger, closing the loop with a live workflow\n\nn8n-webhook-notifier.service.ts fires (fire-and-forget) after\nsync-runner.service.ts creates a Job, so an n8n workflow's WHEN step\ntriggers on a real event instead of polling. A webhook delivery failure\nnever affects the sync itself - it has already committed by then.\n\nThis was verified against the real, live n8n instance, not just built\nand assumed: imported and published an actual workflow (Integration\nStudio - CEIPAL Job to Teams Notify) via n8n's own CLI, restarted the\ncontainer (confirmed first that only 4 workflows are active in\nproduction and got explicit go-ahead before restarting), and confirmed\nvia curl that the webhook responds 200 and starts real execution.\n\nCorrects a real finding: the live n8n domain is connect.jobfynder.com,\nnot n8n.jobfynder.com - that came from a stale, unused docker-compose.yml\nat /opt/n8n/ that doesn't match what's actually running\n(/docker/n8n/docker-compose.yml). Documented in\nCORE-600-integration-studio.md Sec7a so nobody trusts the stale copy again.\n\nThe workflow's WHEN and DO(sync) steps are real; the THEN step (HTTP\nRequest to COMM-1's /notify/teams) is wired but will 404 until that\nendpoint exists - same \"structurally complete, not live-verified\"\npattern used throughout this module, not silently implied as finished.\n\nThe webhook path is itself the access-control secret and is\ndeliberately not written into .env.example or any committed file, same\ndiscipline held for the CORE database password and\nHERMES_COMM_SHARED_SECRET earlier this session.\n\n27/27 tests pass across the module (23 existing + 4 new for the notifier).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-31T20:14:51-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/7733a596e6f835044be6011a6e6d2203de27424c","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T20:14:51-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T20:14:51-04:00","username":"jobfynder"},"added":["src/integration-studio/n8n-bridge/n8n-webhook-notifier.service.spec.ts","src/integration-studio/n8n-bridge/n8n-webhook-notifier.service.ts"],"removed":[],"modified":[".env.example","docs/integration-studio/CORE-600-integration-studio.md","src/integration-studio/integration-studio.module.ts","src/integration-studio/sync-runner.service.spec.ts","src/integration-studio/sync-runner.service.ts"]}],"head_commit":{"id":"7733a596e6f835044be6011a6e6d2203de27424c","tree_id":"5dc5e29c4d59c3b5bfecfd6dff6c42d9c34d59da","distinct":true,"message":"Add Core -> n8n webhook trigger, closing the loop with a live workflow\n\nn8n-webhook-notifier.service.ts fires (fire-and-forget) after\nsync-runner.service.ts creates a Job, so an n8n workflow's WHEN step\ntriggers on a real event instead of polling. A webhook delivery failure\nnever affects the sync itself - it has already committed by then.\n\nThis was verified against the real, live n8n instance, not just built\nand assumed: imported and published an actual workflow (Integration\nStudio - CEIPAL Job to Teams Notify) via n8n's own CLI, restarted the\ncontainer (confirmed first that only 4 workflows are active in\nproduction and got explicit go-ahead before restarting), and confirmed\nvia curl that the webhook responds 200 and starts real execution.\n\nCorrects a real finding: the live n8n domain is connect.jobfynder.com,\nnot n8n.jobfynder.com - that came from a stale, unused docker-compose.yml\nat /opt/n8n/ that doesn't match what's actually running\n(/docker/n8n/docker-compose.yml). Documented in\nCORE-600-integration-studio.md Sec7a so nobody trusts the stale copy again.\n\nThe workflow's WHEN and DO(sync) steps are real; the THEN step (HTTP\nRequest to COMM-1's /notify/teams) is wired but will 404 until that\nendpoint exists - same \"structurally complete, not live-verified\"\npattern used throughout this module, not silently implied as finished.\n\nThe webhook path is itself the access-control secret and is\ndeliberately not written into .env.example or any committed file, same\ndiscipline held for the CORE database password and\nHERMES_COMM_SHARED_SECRET earlier this session.\n\n27/27 tests pass across the module (23 existing + 4 new for the notifier).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-08-31T20:14:51-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/7733a596e6f835044be6011a6e6d2203de27424c","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T20:14:51-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-31T20:14:51-04:00","username":"jobfynder"},"added":["src/integration-studio/n8n-bridge/n8n-webhook-notifier.service.spec.ts","src/integration-studio/n8n-bridge/n8n-webhook-notifier.service.ts"],"removed":[],"modified":[".env.example","docs/integration-studio/CORE-600-integration-studio.md","src/integration-studio/integration-studio.module.ts","src/integration-studio/sync-runner.service.spec.ts","src/integration-studio/sync-runner.service.ts"]}}
