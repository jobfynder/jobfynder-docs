{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-08-29T11:48:48Z","pushed_at":1788004622,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":500,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":2,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":"refs/heads/backup/hermes-850-llm-company-20260829075645","compare":"https://github.com/jobfynder/hermes/compare/67ca4b626f9a...8cb523473bca","commits":[{"id":"8cb523473bca588afd2d08df9d237b9b49975edf","tree_id":"9aba9148bd181c3e3a941b5b520c996e0b3f9604","distinct":false,"message":"fix(email-parsing): ask the LLM fallback to extract company too\n\nThe deterministic company extractor (job_description_fields.py) needs\nEnd Client:/Client:/Company: to start its own line -- fine for real\nHTML mail (now that _strip_html preserves line breaks), but some\nforwarded postings arrive as one flat line of plain text with no line\nbreaks anywhere, and the line-anchored regex cannot find a label\nburied mid-paragraph there. Confirmed on a real production draft:\ncompany came back empty despite End Client: Abbott Labs being present\nin the text, on the same flat-text email that already triggered the\nLLM fallback for other empty fields.\n\nJOB_REQUIREMENT_FIELDS drives both what job_schema tells the LLM to\nlook for and which returned fields get copied back -- company was\nsimply missing from that list, so the LLM was never even asked. Add\nit; the anti-hallucination guarantee (only fills genuinely empty\nfields, never overwrites a deterministic hit) applies to it exactly\nlike every other field already in the list.\n\nDeliberately not adding a loose (non-line-anchored) regex fallback to\nthe deterministic extractor instead: a short generic label like\nCompany:/Client: with no line anchor risks matching mid-sentence and\nextracting nonsense, which is worse than a null the LLM fallback can\nstill fill.","timestamp":"2026-08-29T07:56:40-04:00","url":"https://github.com/jobfynder/hermes/commit/8cb523473bca588afd2d08df9d237b9b49975edf","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:56:40-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:56:40-04:00"},"added":[],"removed":[],"modified":["app/email_parsing/llm_fallback.py","scripts/hermes-850-email-llm-fallback-check.py"]}],"head_commit":{"id":"8cb523473bca588afd2d08df9d237b9b49975edf","tree_id":"9aba9148bd181c3e3a941b5b520c996e0b3f9604","distinct":false,"message":"fix(email-parsing): ask the LLM fallback to extract company too\n\nThe deterministic company extractor (job_description_fields.py) needs\nEnd Client:/Client:/Company: to start its own line -- fine for real\nHTML mail (now that _strip_html preserves line breaks), but some\nforwarded postings arrive as one flat line of plain text with no line\nbreaks anywhere, and the line-anchored regex cannot find a label\nburied mid-paragraph there. Confirmed on a real production draft:\ncompany came back empty despite End Client: Abbott Labs being present\nin the text, on the same flat-text email that already triggered the\nLLM fallback for other empty fields.\n\nJOB_REQUIREMENT_FIELDS drives both what job_schema tells the LLM to\nlook for and which returned fields get copied back -- company was\nsimply missing from that list, so the LLM was never even asked. Add\nit; the anti-hallucination guarantee (only fills genuinely empty\nfields, never overwrites a deterministic hit) applies to it exactly\nlike every other field already in the list.\n\nDeliberately not adding a loose (non-line-anchored) regex fallback to\nthe deterministic extractor instead: a short generic label like\nCompany:/Client: with no line anchor risks matching mid-sentence and\nextracting nonsense, which is worse than a null the LLM fallback can\nstill fill.","timestamp":"2026-08-29T07:56:40-04:00","url":"https://github.com/jobfynder/hermes/commit/8cb523473bca588afd2d08df9d237b9b49975edf","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:56:40-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:56:40-04:00"},"added":[],"removed":[],"modified":["app/email_parsing/llm_fallback.py","scripts/hermes-850-email-llm-fallback-check.py"]}}
