{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-09-08T21:59:11Z","pushed_at":1788907379,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":968,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/2d7c24cdc28f...8917a375f087","commits":[{"id":"8917a375f0874a4ce434f7566c2c8163613429ec","tree_id":"ffaaa613e5474ffde3fed7f2b2976911a4af9278","distinct":true,"message":"fix(startup): load the NER model at app startup, not on the first request that needs it\n\nReal production incident, live-debugged: after a container restart, a\nrequest landing on parse_email_signature's is_pure_forward -> NER\nfallback path (app/email_parsing/signature.py's _get_ner_pipeline,\nlru_cache'd per-process) paid the full cost of loading\nen_core_web_sm synchronously, indistinguishable from a hang -- other\nendpoints kept serving normally throughout (confirmed via the review\nUI working fine while the stuck request sat there), and pg_stat_\nactivity showed nothing running in the database, which is what\neventually pointed at this rather than a DB lock or a runaway regex.\nMeasured at well over ten minutes cold on this deployment's hardware\n-- far past what the module's own original docstring assumed\n(\"a fresh spaCy pipeline load costs real time\" undersold it badly).\n\nAdds warm_ner_pipeline() (thin wrapper forcing the lru_cache'd load)\nand calls it from a new FastAPI startup event in app/main.py, right\nalongside the existing schema-init one. Moves the cost to container\nstart, where a slow boot is expected and doesn't masquerade as a\nbroken API call -- every request after that point, including the\nvery first one that needs NER, is fast.\n\nSafe in CI: if spacy or its model isn't installed, _get_ner_pipeline\nalready returns None without raising (existing behavior), so the new\nstartup call is a no-op there.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-09T04:12:58+05:30","url":"https://github.com/jobfynder/hermes/commit/8917a375f0874a4ce434f7566c2c8163613429ec","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T18:41:53-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-09T04:12:58+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":["app/email_parsing/signature.py","app/main.py","scripts/hermes-850-email-signature-check.py"]}],"head_commit":{"id":"8917a375f0874a4ce434f7566c2c8163613429ec","tree_id":"ffaaa613e5474ffde3fed7f2b2976911a4af9278","distinct":true,"message":"fix(startup): load the NER model at app startup, not on the first request that needs it\n\nReal production incident, live-debugged: after a container restart, a\nrequest landing on parse_email_signature's is_pure_forward -> NER\nfallback path (app/email_parsing/signature.py's _get_ner_pipeline,\nlru_cache'd per-process) paid the full cost of loading\nen_core_web_sm synchronously, indistinguishable from a hang -- other\nendpoints kept serving normally throughout (confirmed via the review\nUI working fine while the stuck request sat there), and pg_stat_\nactivity showed nothing running in the database, which is what\neventually pointed at this rather than a DB lock or a runaway regex.\nMeasured at well over ten minutes cold on this deployment's hardware\n-- far past what the module's own original docstring assumed\n(\"a fresh spaCy pipeline load costs real time\" undersold it badly).\n\nAdds warm_ner_pipeline() (thin wrapper forcing the lru_cache'd load)\nand calls it from a new FastAPI startup event in app/main.py, right\nalongside the existing schema-init one. Moves the cost to container\nstart, where a slow boot is expected and doesn't masquerade as a\nbroken API call -- every request after that point, including the\nvery first one that needs NER, is fast.\n\nSafe in CI: if spacy or its model isn't installed, _get_ner_pipeline\nalready returns None without raising (existing behavior), so the new\nstartup call is a no-op there.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-09T04:12:58+05:30","url":"https://github.com/jobfynder/hermes/commit/8917a375f0874a4ce434f7566c2c8163613429ec","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T18:41:53-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-09T04:12:58+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":["app/email_parsing/signature.py","app/main.py","scripts/hermes-850-email-signature-check.py"]}}
