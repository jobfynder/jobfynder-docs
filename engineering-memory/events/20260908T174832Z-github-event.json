ithub.com/repos/jobfynder/hermes/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-09-08T16:34:58Z","pushed_at":1788889706,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":851,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":1,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":1,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/f52665a3f0f1...d56a70543bb9","commits":[{"id":"d56a70543bb92f509442357a654f264d049fc98c","tree_id":"9f65ea87630d81c8fcb20dd0baf7a1164fb17ca7","distinct":true,"message":"fix(ci): make hermes-runtime storage root env-configurable so CI can actually run\n\nEvery regression-suite CI run on main has been failing at import time\nfor at least the last 5 pushes (2026-09-02 onward), unrelated to any\nspecific change: app/runtime/jsonl_store.py hardcoded\nRUNTIME_ROOT = Path(\"/hermes-runtime\"), a path that only exists via\nthe real deployment's Docker volume, not on the GitHub Actions\nrunner's root filesystem. Every check script pulls this in\ntransitively (app.channels.service -> app.access.service ->\napp.runtime.events), so the suite never got past the first import.\n\nSame fix pattern already used elsewhere in this codebase\n(HERMES_ACCESS_CONTROL_FILE, HERMES_TAXONOMY_RUNTIME_DIR,\nHERMES_PROMPT_RUN_LOG_DIR): read the root from an env var with the\nsame default, so production behavior is unchanged, and point CI at\nthe runner's own writable temp dir instead.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T13:48:24-04:00","url":"https://github.com/jobfynder/hermes/commit/d56a70543bb92f509442357a654f264d049fc98c","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:48:24-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:48:24-04:00","username":"jobfynder"},"added":[],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/runtime/jsonl_store.py"]}],"head_commit":{"id":"d56a70543bb92f509442357a654f264d049fc98c","tree_id":"9f65ea87630d81c8fcb20dd0baf7a1164fb17ca7","distinct":true,"message":"fix(ci): make hermes-runtime storage root env-configurable so CI can actually run\n\nEvery regression-suite CI run on main has been failing at import time\nfor at least the last 5 pushes (2026-09-02 onward), unrelated to any\nspecific change: app/runtime/jsonl_store.py hardcoded\nRUNTIME_ROOT = Path(\"/hermes-runtime\"), a path that only exists via\nthe real deployment's Docker volume, not on the GitHub Actions\nrunner's root filesystem. Every check script pulls this in\ntransitively (app.channels.service -> app.access.service ->\napp.runtime.events), so the suite never got past the first import.\n\nSame fix pattern already used elsewhere in this codebase\n(HERMES_ACCESS_CONTROL_FILE, HERMES_TAXONOMY_RUNTIME_DIR,\nHERMES_PROMPT_RUN_LOG_DIR): read the root from an env var with the\nsame default, so production behavior is unchanged, and point CI at\nthe runner's own writable temp dir instead.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-08T13:48:24-04:00","url":"https://github.com/jobfynder/hermes/commit/d56a70543bb92f509442357a654f264d049fc98c","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:48:24-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T13:48:24-04:00","username":"jobfynder"},"added":[],"removed":[],"modified":[".github/workflows/hermes-regression.yml","app/runtime/jsonl_store.py"]}}
