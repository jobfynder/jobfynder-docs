{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-08-29T15:00:16Z","pushed_at":1788018338,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":515,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":2,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":"refs/heads/backup/hermes-850-signature-ner-20260829114521","compare":"https://github.com/jobfynder/hermes/compare/5a2fa1fb4767...272a1e5a62bd","commits":[{"id":"7c5a631ad33468e15df2c74808ef744ab414dba9","tree_id":"9cd3d1d7033b7a901f668e3f4daf98253ecd3c13","distinct":false,"message":"feat(email-parsing): add NER fallback for fragmented signature blocks\n\nCloses the limitation flagged after the pure-forward signature fix:\none vendor's postings render the sender's name/company as one bare\ntoken per line after HTML->text conversion (\"From: / / Harry, / /\nITECSUS / / harry@itecsus.com\") -- no title keyword, no recognized\ncompany suffix, no multi-word name on a single line, so the\nregex-only pass (NAME_LINE_RE, COMPANY_SUFFIX_RE) has nothing to\nanchor on.\n\nspaCy was already an installed dependency (used only for\ntokenization elsewhere in the codebase) -- downloads en_core_web_sm\n(~13MB model, pinned as a wheel URL so it's baked into the image at\nbuild time, not a runtime `spacy download`) and uses its PERSON/ORG\nrecognition as a secondary signal, only for whichever of name/company\nthe structural pass left empty. Never overrides a structural match.\nNot an LLM call: no network request, no API cost, a few ms of local\ninference once the model is loaded (cached per-process).\n\nGated to the is_pure_forward case specifically (see the prior\nsignature.py commit), not the generic tail-window fallback: real\ntesting against production drafts turned up genuine false positives\n(an all-caps tech term and a stray two-letter acronym both mistaken\nfor a person's name) whenever NER ran on a span the tail-window\nheuristic only weakly justified. is_pure_forward's span position is\nstructurally justified -- right after a real forwarded-header block --\nso it's the one case worth trusting a secondary guess on; everywhere\nelse, an honest \"not detected\" beats a confident-looking wrong name.\nAlso added a lowercase-required filter on PERSON candidates\nspecifically (TIBCO, JD read as all-caps and got rejected) -- kept\nseparate from the ORG filter, which stays permissive, since a real\ncompany name is routinely all-caps in a way a person's name never is.\n\nVerified against the same three real production drafts already\nreparsed twice this session: the well-structured AWS Connect/Oncor\none now recovers \"Harry\" as full_name via NER (previously nothing);\nthe other two -- one hitting the tail-window fallback, one genuinely\nflat single-line text -- correctly stay at their prior (honest, if\nincomplete) output with no new false positives. The existing\nwell-formed-signature case (name/title/company/LinkedIn all found\nstructurally) is unaffected -- NER never runs when the structural\npass already found everything.\n\nNew coverage in hermes-850-email-signature-check.py: one test\nconfirming the NER recovery on the fragmented fixture (and that it's\ntagged with its own ner_person method, not conflated with a\nstructural match), one confirming NER stays off and produces no\nfabricated name for a span the tail-window fallback only weakly\njustified. Full regression suite (16 checks across hermes-850-*,\nhermes-400-*, hermes-450-channel-intake-check.py) green against a\nfreshly reset schema. Docker image grows ~30MB with the model baked\nin.","timestamp":"2026-08-29T11:45:11-04:00","url":"https://github.com/jobfynder/hermes/commit/7c5a631ad33468e15df2c74808ef744ab414dba9","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:11-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:11-04:00"},"added":["commit-msg.txt"],"removed":[],"modified":["app/email_parsing/signature.py","requirements.txt","scripts/hermes-850-email-signature-check.py"]},{"id":"272a1e5a62bd879845d23bf55b7d571c3203f240","tree_id":"a3f985fc554248f65da1e0649a5accdd78940db9","distinct":false,"message":"chore: remove stray commit-msg.txt accidentally staged by the previous commit","timestamp":"2026-08-29T11:45:17-04:00","url":"https://github.com/jobfynder/hermes/commit/272a1e5a62bd879845d23bf55b7d571c3203f240","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:17-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:17-04:00"},"added":[],"removed":["commit-msg.txt"],"modified":[]}],"head_commit":{"id":"272a1e5a62bd879845d23bf55b7d571c3203f240","tree_id":"a3f985fc554248f65da1e0649a5accdd78940db9","distinct":false,"message":"chore: remove stray commit-msg.txt accidentally staged by the previous commit","timestamp":"2026-08-29T11:45:17-04:00","url":"https://github.com/jobfynder/hermes/commit/272a1e5a62bd879845d23bf55b7d571c3203f240","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:17-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T11:45:17-04:00"},"added":[],"removed":["commit-msg.txt"],"modified":[]}}
