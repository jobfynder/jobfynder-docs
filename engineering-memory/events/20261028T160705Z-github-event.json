,"stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":true,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-FE-vite/commit/119d196e3952","commits":[{"id":"119d196e39525de32721880556c0d6d63e3b6cfa","tree_id":"3a4a6d5db1e804bb4de4d8d112a43941989cfc91","distinct":true,"message":"feat(job-tracker): wire the Job Tracker screen to Core's real API for all three roles\n\nCore's Job Tracker API (job-tracker-core / extension-tracker-on-core)\nalready exists server-side but nothing on the frontend called it except\na half-built extension-shaped consultant path. This replaces the mock\ndata path with the real one for every role Core supports:\n\n- consultant: personal records (/job-tracker/records), the existing\n  AdvancedDataTable + status tabs, now reading/writing real data.\n  Delete now does a real soft-delete via Core (it used to be local-only).\n- bench_sales: new \"My Submissions\" board (/job-tracker/submissions),\n  showing only fields Core actually tracks (stage, dates, flags,\n  checklist progress) -- no fabricated match score, priority or margin.\n  This replaces the old bench-desk mock that consultant and bench_sales\n  both incorrectly shared.\n- recruiter: new read-only \"Job Tracker\" board (/job-tracker/jobs),\n  with real per-job submission counts and the same stat-card flags\n  Core's summary endpoint defines, so a card's number always matches\n  its list. \"Add a New Job\" is preserved and now refreshes the board\n  on success.\n- employer: unchanged (Core does not model Employer here yet, per its\n  own roadmap note); still the original sample board.\n\nsrc/services/job-tracker.ts is a single client matching Core's real\ncontract (docs/job-tracker/JOB-TRACKER-API.md): records, submissions,\njobs, each with their own status/flag vocabulary, read directly from\nthe DTOs and services rather than guessed.\n\nVerified: tsc clean (pre-existing unrelated errors only), eslint clean\non every changed file, production build succeeds, and a live run\nagainst a stand-in Core server confirmed real requests/responses for\nall three roles (including the DELETE round-trip for a consultant\nrecord, visible in the network log as the exact\n/api/job-tracker/records/:id route).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-10-28T12:06:52-04:00","url":"https://github.com/jobfynder-admin/jobFynder-FE-vite/commit/119d196e39525de32721880556c0d6d63e3b6cfa","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-10-28T12:06:52-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-10-28T12:06:52-04:00","username":"jobfynder"},"added":["src/components/components/private/job-tracker/BenchSalesSubmissionsBoard.tsx","src/components/components/private/job-tracker/RecruiterJobsBoard.tsx","src/services/job-tracker.ts"],"removed":[],"modified":["src/components/components/private/job-tracker/Toolbar.tsx","src/components/components/private/job-tracker/useJobTracker.ts","src/pages/private/JobTrackerBoard.tsx","src/types/job-tracker.ts"]}],"head_commit":{"id":"119d196e39525de32721880556c0d6d63e3b6cfa","tree_id":"3a4a6d5db1e804bb4de4d8d112a43941989cfc91","distinct":true,"message":"feat(job-tracker): wire the Job Tracker screen to Core's real API for all three roles\n\nCore's Job Tracker API (job-tracker-core / extension-tracker-on-core)\nalready exists server-side but nothing on the frontend called it except\na half-built extension-shaped consultant path. This replaces the mock\ndata path with the real one for every role Core supports:\n\n- consultant: personal records (/job-tracker/records), the existing\n  AdvancedDataTable + status tabs, now reading/writing real data.\n  Delete now does a real soft-delete via Core (it used to be local-only).\n- bench_sales: new \"My Submissions\" board (/job-tracker/submissions),\n  showing only fields Core actually tracks (stage, dates, flags,\n  checklist progress) -- no fabricated match score, priority or margin.\n  This replaces the old bench-desk mock that consultant and bench_sales\n  both incorrectly shared.\n- recruiter: new read-only \"Job Tracker\" board (/job-tracker/jobs),\n  with real per-job submission counts and the same stat-card flags\n  Core's summary endpoint defines, so a card's number always matches\n  its list. \"Add a New Job\" is preserved and now refreshes the board\n  on success.\n- employer: unchanged (Core does not model Employer here yet, per its\n  own roadmap note); still the original sample board.\n\nsrc/services/job-tracker.ts is a single client matching Core's real\ncontract (docs/job-tracker/JOB-TRACKER-API.md): records, submissions,\njobs, each with their own status/flag vocabulary, read directly from\nthe DTOs and services rather than guessed.\n\nVerified: tsc clean (pre-existing unrelated errors only), eslint clean\non every changed file, production build succeeds, and a live run\nagainst a stand-in Core server confirmed real requests/responses for\nall three roles (including the DELETE round-trip for a consultant\nrecord, visible in the network log as the exact\n/api/job-tracker/records/:id route).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-10-28T12:06:52-04:00","url":"https://github.com/jobfynder-admin/jobFynder-FE-vite/commit/119d196e39525de32721880556c0d6d63e3b6cfa","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-10-28T12:06:52-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-10-28T12:06:52-04:00","username":"jobfynder"},"added":["src/components/components/private/job-tracker/BenchSalesSubmissionsBoard.tsx","src/components/components/private/job-tracker/RecruiterJobsBoard.tsx","src/services/job-tracker.ts"],"removed":[],"modified":["src/components/components/private/job-tracker/Toolbar.tsx","src/components/components/private/job-tracker/useJobTracker.ts","src/pages/private/JobTrackerBoard.tsx","src/types/job-tracker.ts"]}}
