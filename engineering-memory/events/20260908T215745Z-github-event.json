{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-09-08T21:41:26Z","pushed_at":1788904659,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":968,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/e4071bfa62b4...2d7c24cdc28f","commits":[{"id":"2d7c24cdc28ff6fef2b92f60abba627f571aa156","tree_id":"b6c2a2256b3fcd6f8ee0232976445670afd5e5bf","distinct":true,"message":"perf(drafts): batch full-reparse writes into one transaction instead of one per row\n\nMeasured against production after #11 deployed: re-parsing itself is\n~0.5s/draft (pure CPU, no DB access), but a 100-row apply batch didn't\nfinish in 180s -- because every row opened its own `with cursor()` for\nthe UPDATE and, separately, its own for record_field_provenance's\nINSERT. Each is its own commit/network round-trip; a bulk operation\nover hundreds or thousands of rows can't afford two of those per row\non top of the parsing cost.\n\nSplit into two phases: phase 1 does all the CPU-bound re-parsing with\nzero database access, collecting what needs writing; phase 2 (only\nwhen dry_run=False and there's something to write) opens ONE\ntransaction and does every UPDATE, every no-op row's updated_at touch,\nand every provenance insert against it, committing once at the end.\n\nrecord_field_provenance (app/email_parsing/provenance.py) gets an\noptional `cur` parameter to reuse an already-open cursor instead of\nopening its own -- every existing call site is unaffected, since not\npassing it keeps the exact prior behavior (open one, commit, close).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-09T03:27:38+05:30","url":"https://github.com/jobfynder/hermes/commit/2d7c24cdc28ff6fef2b92f60abba627f571aa156","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T17:53:03-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-09T03:27:38+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":["app/drafts/service.py","app/email_parsing/provenance.py"]}],"head_commit":{"id":"2d7c24cdc28ff6fef2b92f60abba627f571aa156","tree_id":"b6c2a2256b3fcd6f8ee0232976445670afd5e5bf","distinct":true,"message":"perf(drafts): batch full-reparse writes into one transaction instead of one per row\n\nMeasured against production after #11 deployed: re-parsing itself is\n~0.5s/draft (pure CPU, no DB access), but a 100-row apply batch didn't\nfinish in 180s -- because every row opened its own `with cursor()` for\nthe UPDATE and, separately, its own for record_field_provenance's\nINSERT. Each is its own commit/network round-trip; a bulk operation\nover hundreds or thousands of rows can't afford two of those per row\non top of the parsing cost.\n\nSplit into two phases: phase 1 does all the CPU-bound re-parsing with\nzero database access, collecting what needs writing; phase 2 (only\nwhen dry_run=False and there's something to write) opens ONE\ntransaction and does every UPDATE, every no-op row's updated_at touch,\nand every provenance insert against it, committing once at the end.\n\nrecord_field_provenance (app/email_parsing/provenance.py) gets an\noptional `cur` parameter to reuse an already-open cursor instead of\nopening its own -- every existing call site is unaffected, since not\npassing it keeps the exact prior behavior (open one, commit, close).\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","timestamp":"2026-09-09T03:27:38+05:30","url":"https://github.com/jobfynder/hermes/commit/2d7c24cdc28ff6fef2b92f60abba627f571aa156","author":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-08T17:53:03-04:00","username":"jobfynder"},"committer":{"name":"Jobfynder","email":"167116843+jobfynder@users.noreply.github.com","date":"2026-09-09T03:27:38+05:30","username":"jobfynder"},"added":[],"removed":[],"modified":["app/drafts/service.py","app/email_parsing/provenance.py"]}}
