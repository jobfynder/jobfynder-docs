om/repos/jobfynder/hermes/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/jobfynder/hermes/labels{/name}","releases_url":"https://api.github.com/repos/jobfynder/hermes/releases{/id}","deployments_url":"https://api.github.com/repos/jobfynder/hermes/deployments","created_at":1782956269,"updated_at":"2026-08-29T11:26:06Z","pushed_at":1788004092,"git_url":"git://github.com/jobfynder/hermes.git","ssh_url":"git@github.com:jobfynder/hermes.git","clone_url":"https://github.com/jobfynder/hermes.git","svn_url":"https://github.com/jobfynder/hermes","homepage":null,"size":500,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":true,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":2,"license":null,"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":2,"watchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder","email":"167116843+jobfynder@users.noreply.github.com"},"forced":false,"sender":{"login":"jobfynder","id":167116843,"node_id":"U_kgDOCfYAKw","avatar_url":"https://avatars.githubusercontent.com/u/167116843?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder","html_url":"https://github.com/jobfynder","followers_url":"https://api.github.com/users/jobfynder/followers","following_url":"https://api.github.com/users/jobfynder/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":true,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/hermes/compare/9809bd0217d5^...67ca4b626f9a","commits":[{"id":"9809bd0217d5cc2ccd0736bdf5d93f025e436eb8","tree_id":"8f05cddb015d558410d28eada1e3b1b069b46bee","distinct":true,"message":"fix(email-parsing): extract company/end-client, clean job description, preserve HTML line structure\n\nRoot cause: _strip_html() collapsed every block-level tag (<br>, <p>,\n<div>, <tr>, <li>) to a single space instead of a newline, so a real\nHTML email came out as one giant run-on line. Every line-anchored\nfield extractor downstream (job title, required skills, and now\ncompany) silently stopped finding its labels on real mail -- only\nplain-text or already-line-broken fixtures worked. Fixed by turning\nblock-level tags into newlines before the rest of the markup is\nstripped, decoding HTML entities (&nbsp;/&lt;/&gt;/&amp; were showing\nup literally in parsed text), and collapsing only horizontal\nwhitespace, not paragraph breaks.\n\nTwo gaps this surfaced, both confirmed against real production\ndrafts (Azure Integration Services Consultant / Abbott Labs, AWS\nConnect Solutions Engineer / Oncor):\n\n1. No field anywhere captured the job's actual client/company --\n   \"End Client: Abbott Labs\" was sitting in the raw text with nowhere\n   to go. Added company extraction (End Client/Client/Company/\n   Employer labels) through the same path as location/rate/employment\n   type: job_description_fields.py -> JobDescriptionStructuredData ->\n   basic.py -> the job_requirement record -> field_provenance ->\n   the review frontend -> Core's clientName on push (which was\n   previously reading the recruiter's own signature company instead\n   of the actual end client -- backwards for a job listing).\n\n2. job_description stored the entire raw email verbatim, including\n   the forwarded-message header block and the SEO-keyword/call-to-\n   action footer many broadcast job boards append -- and it was never\n   rendered in the review frontend at all (a gap in the original\n   build, not a parser issue), so a well-parsed field looked \"missing\"\n   to a reviewer. Added a conservative cleanup (strips only the top\n   From:/Sent:/To:/Subject: block and known footer markers, not\n   vendor-specific submission instructions, since a real JD can\n   legitimately be a numbered list) and added the field to the\n   detail page as a collapsible block with its own provenance chip.\n\nAlso fixes a title-extraction regression the newline change would\notherwise have introduced: when the real job title sits several\nparagraphs past a forwarding preamble, existing extraction found\nnothing. Added a same-email-subject fallback (only for the first\nsection, reusing the existing probable-title heuristic) so a title\nis still found from the one place it's almost always spelled out\ncorrectly.\n\nNew coverage: hermes-850-email-parsing-check.py gets a full forwarded-\nposting fixture asserting title/company/location/description-cleanup\ntogether; hermes-850-gmail-graph-provider-check.py gets a dedicated\nline-structure/entity-decoding check. Full existing regression suite\nverified green against a freshly reset schema.","timestamp":"2026-08-29T07:47:52-04:00","url":"https://github.com/jobfynder/hermes/commit/9809bd0217d5cc2ccd0736bdf5d93f025e436eb8","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:47:52-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:47:52-04:00"},"added":["commit-msg.txt"],"removed":[],"modified":["app/email_parsing/llm_fallback.py","app/email_parsing/parsers.py","app/email_parsing/provenance.py","app/integrations/core_job_push.py","app/providers/microsoft_graph/service.py","app/understanding/parsers/basic.py","app/understanding/parsers/job_description_fields.py","app/understanding/structured.py","frontend/src/pages/DraftDetailPage.tsx","frontend/src/types.ts","scripts/hermes-850-email-parsing-check.py","scripts/hermes-850-gmail-graph-provider-check.py"]},{"id":"67ca4b626f9a4117c1208f7f0f1acb9e01ec14ab","tree_id":"702aa638bca224a5e8a1cb0d64e8a0ecc43dedd0","distinct":true,"message":"chore: remove stray commit-msg.txt accidentally staged by the previous commit","timestamp":"2026-08-29T07:48:02-04:00","url":"https://github.com/jobfynder/hermes/commit/67ca4b626f9a4117c1208f7f0f1acb9e01ec14ab","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:48:02-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:48:02-04:00"},"added":[],"removed":["commit-msg.txt"],"modified":[]}],"head_commit":{"id":"67ca4b626f9a4117c1208f7f0f1acb9e01ec14ab","tree_id":"702aa638bca224a5e8a1cb0d64e8a0ecc43dedd0","distinct":true,"message":"chore: remove stray commit-msg.txt accidentally staged by the previous commit","timestamp":"2026-08-29T07:48:02-04:00","url":"https://github.com/jobfynder/hermes/commit/67ca4b626f9a4117c1208f7f0f1acb9e01ec14ab","author":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:48:02-04:00"},"committer":{"name":"Jobfynder Automation","email":"automation@jobfynder.com","date":"2026-08-29T07:48:02-04:00"},"added":[],"removed":["commit-msg.txt"],"modified":[]}}
