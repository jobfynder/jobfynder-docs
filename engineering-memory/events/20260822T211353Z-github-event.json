atchers":0,"default_branch":"main","stargazers":0,"master_branch":"main"},"pusher":{"name":"jobfynder-admin","email":"jobfynder.com@gmail.com"},"forced":false,"sender":{"login":"jobfynder-admin","id":213675935,"node_id":"U_kgDODLxvnw","avatar_url":"https://avatars.githubusercontent.com/u/213675935?v=4","gravatar_id":"","url":"https://api.github.com/users/jobfynder-admin","html_url":"https://github.com/jobfynder-admin","followers_url":"https://api.github.com/users/jobfynder-admin/followers","following_url":"https://api.github.com/users/jobfynder-admin/following{/other_user}","gists_url":"https://api.github.com/users/jobfynder-admin/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder-admin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder-admin/subscriptions","organizations_url":"https://api.github.com/users/jobfynder-admin/orgs","repos_url":"https://api.github.com/users/jobfynder-admin/repos","events_url":"https://api.github.com/users/jobfynder-admin/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder-admin/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/compare/b1df7ad3bc40...d4a314404196","commits":[{"id":"d4a314404196facd310cd1cf59960200801d93eb","tree_id":"8459e1a73fe36a6b2b0b74acf247b148b964e020","distinct":true,"message":"feat(resume): add resume variants (label, variantType, parentResumeId)\n\nSecond piece of the resume-persistence foundation, on top of this\nsame PR's auth-guard fix. A \"variant\" (role-based, job-specific,\ncompany-specific, recruiter-requested, or blind-resume) is just\nanother `resumes` row -- same content, tagged with a parent and a\ntype -- not a new table or subsystem.\n\nSchema: additive migration adding `label`, `variantType`, and\n`parentResumeId` (self-relation, ON DELETE SET NULL so deleting a\nbase resume doesn't cascade-delete every variant built from it).\n`label` is new because there was no way to give a resume record its\nown display name before (\"Java Tech Lead - Fintech Focus\" as opposed\nto `title`, which is the professional headline printed on the resume\nitself, e.g. \"Senior Java Developer\" -- those are different things\nand would otherwise collide once a user has more than one resume).\n\nNew endpoints, both ownership-checked the same way every other route\nhere is (only works on a resume the caller already owns):\n- POST /resume/:id/variants -- copies :id's content into a new row,\n  tagged with parentResumeId=:id, the given label/variantType, and an\n  optional targetRole/targetCompany merged into builderMetadata.\n- GET /resume/:id/variants -- lists variants of :id.\n\nExtended resume.controller.spec.ts to cover both new routes (8/8\npassing). `nest build` / `tsc --noEmit` clean, `prisma generate` picks\nup the new fields with no errors. Same caveat as the first commit:\nnot yet run against a live database.","timestamp":"2026-08-22T17:13:41-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/d4a314404196facd310cd1cf59960200801d93eb","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-22T17:13:41-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-22T17:13:41-04:00","username":"jobfynder"},"added":["prisma/migrations/20260822010000_add_resume_variants/migration.sql"],"removed":[],"modified":["prisma/schema.prisma","src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]}],"head_commit":{"id":"d4a314404196facd310cd1cf59960200801d93eb","tree_id":"8459e1a73fe36a6b2b0b74acf247b148b964e020","distinct":true,"message":"feat(resume): add resume variants (label, variantType, parentResumeId)\n\nSecond piece of the resume-persistence foundation, on top of this\nsame PR's auth-guard fix. A \"variant\" (role-based, job-specific,\ncompany-specific, recruiter-requested, or blind-resume) is just\nanother `resumes` row -- same content, tagged with a parent and a\ntype -- not a new table or subsystem.\n\nSchema: additive migration adding `label`, `variantType`, and\n`parentResumeId` (self-relation, ON DELETE SET NULL so deleting a\nbase resume doesn't cascade-delete every variant built from it).\n`label` is new because there was no way to give a resume record its\nown display name before (\"Java Tech Lead - Fintech Focus\" as opposed\nto `title`, which is the professional headline printed on the resume\nitself, e.g. \"Senior Java Developer\" -- those are different things\nand would otherwise collide once a user has more than one resume).\n\nNew endpoints, both ownership-checked the same way every other route\nhere is (only works on a resume the caller already owns):\n- POST /resume/:id/variants -- copies :id's content into a new row,\n  tagged with parentResumeId=:id, the given label/variantType, and an\n  optional targetRole/targetCompany merged into builderMetadata.\n- GET /resume/:id/variants -- lists variants of :id.\n\nExtended resume.controller.spec.ts to cover both new routes (8/8\npassing). `nest build` / `tsc --noEmit` clean, `prisma generate` picks\nup the new fields with no errors. Same caveat as the first commit:\nnot yet run against a live database.","timestamp":"2026-08-22T17:13:41-04:00","url":"https://github.com/jobfynder-admin/jobFynder-BE-nestJS/commit/d4a314404196facd310cd1cf59960200801d93eb","author":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-22T17:13:41-04:00","username":"jobfynder"},"committer":{"name":"Pavan","email":"pavan@jobfynder.com","date":"2026-08-22T17:13:41-04:00","username":"jobfynder"},"added":["prisma/migrations/20260822010000_add_resume_variants/migration.sql"],"removed":[],"modified":["prisma/schema.prisma","src/resume/dto/create-resume.dto.ts","src/resume/resume.controller.spec.ts","src/resume/resume.controller.ts"]}}
