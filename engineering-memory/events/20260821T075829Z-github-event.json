ollowing{/other_user}","gists_url":"https://api.github.com/users/jobfynder/gists{/gist_id}","starred_url":"https://api.github.com/users/jobfynder/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jobfynder/subscriptions","organizations_url":"https://api.github.com/users/jobfynder/orgs","repos_url":"https://api.github.com/users/jobfynder/repos","events_url":"https://api.github.com/users/jobfynder/events{/privacy}","received_events_url":"https://api.github.com/users/jobfynder/received_events","type":"User","user_view_type":"public","site_admin":false},"created":false,"deleted":false,"base_ref":null,"compare":"https://github.com/jobfynder/jobfynder-infra/compare/ec10b6bfce41...814a8eda3fb1","commits":[{"id":"26fc1c42e7f11ecfe45dd10aa2f5361dab74a260","tree_id":"a227ac90490bf487859f37f0ba50735c0c545002","distinct":false,"message":"feat(comm): add production Telegram bridge","timestamp":"2026-07-11T19:56:57Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/26fc1c42e7f11ecfe45dd10aa2f5361dab74a260","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-11T19:56:57Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-11T19:56:57Z"},"added":["communication/Dockerfile.comm-gateway","communication/comm_gateway/__init__.py","communication/comm_gateway/config.py","communication/comm_gateway/hermes_client.py","communication/comm_gateway/main.py","communication/comm_gateway/telegram.py","communication/requirements.txt"],"removed":[],"modified":["communication/.env.example","communication/docker-compose.yml"]},{"id":"ca8cd0eea8c511ff5347eda74798ff3e648e7928","tree_id":"c91fbc97d50cf09064383c22bb0f8da7fa3112d1","distinct":false,"message":"feat(comm): deliver Telegram onboarding responses","timestamp":"2026-07-11T21:29:11Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/ca8cd0eea8c511ff5347eda74798ff3e648e7928","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-11T21:29:11Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-11T21:29:11Z"},"added":["communication/comm_gateway/telegram_outbound.py","communication/scripts/comm-telegram-onboarding-check.py","communication/scripts/comm-telegram-onboarding-route-check.py"],"removed":[],"modified":["communication/comm_gateway/main.py","communication/comm_gateway/telegram.py"]},{"id":"0d7616a713881ff610ad7abaf5316c38cb30174e","tree_id":"f179af6bf13248cea8eeaf30e3ae0fd5b4e55f90","distinct":false,"message":"fix(comm): split long Telegram responses safely","timestamp":"2026-07-21T17:48:21Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/0d7616a713881ff610ad7abaf5316c38cb30174e","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-21T17:48:21Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-07-21T17:48:21Z"},"added":["communication/scripts/comm-telegram-message-chunking-check.py"],"removed":[],"modified":["communication/comm_gateway/telegram_outbound.py"]},{"id":"0c3358040a4500345cff9c6c7a0c46f5bb99f282","tree_id":"dd3d9386073ddbe81f115f105714ccef6e801981","distinct":false,"message":"fix(comm): resilient Hermes call, per-IP rate limiting, volume backups\n\nhermes_client.send_to_hermes() previously let httpx timeout/connection\nerrors propagate unhandled out of the Telegram webhook handler -- a slow\nor unreachable Hermes meant the user got no reply and no error was\nrecorded anywhere. Now caught explicitly and returned as a structured\n{status: error, reason: ...} dict, same shape the webhook handler\nalready expects for non-200 responses, so deliver_hermes_telegram_response\nfalls through to its existing could-not-process message instead of the\nrequest just dying.\n\nAdds a simple in-memory per-IP, per-path rate limiter (ratelimit.py,\n120 req/min default) on the whole app -- the public endpoint was already\nreceiving unsolicited scanner traffic (.env, .git/HEAD probes) with\nnothing between it and the internet beyond default Nginx Proxy Manager\nbehavior. Noted as a starting point, not a distributed solution -- if\nthis ever runs multiple replicas, move counters to the Redis instance\nalready running on this host instead of scaling the in-memory version.\n\nAdds a daily backup cron (3am) for the four Docker named volumes\n(RabbitMQ, Redis, NPM data + letsencrypt) with 14-day retention. Only\ntwo ad-hoc manual snapshots existed before this, no automation.\n\nscripts/comm-hermes-client-resilience-check.py verifies the exception\nhandling with mocked timeout/connection-error/missing-secret cases.","timestamp":"2026-08-21T07:25:34Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/0c3358040a4500345cff9c6c7a0c46f5bb99f282","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:25:34Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:25:34Z"},"added":["communication/comm_gateway/ratelimit.py","communication/scripts/comm-1-backup-volumes.sh","communication/scripts/comm-hermes-client-resilience-check.py"],"removed":[],"modified":["communication/comm_gateway/hermes_client.py","communication/comm_gateway/main.py"]},{"id":"814a8eda3fb1ada7ccc9eb5010a6e874a3cea285","tree_id":"6a783cb32832ca9cec7f01627c51caf56f844356","distinct":true,"message":"merge: bring the deployed COMM Gateway branch into main\n\nReconciles main with feature/comm-telegram-message-chunking, the branch\nactually running on COMM-1. This was a clean, non-overlapping divergence\n(main only touched intelligence/, this branch only touched communication/)\nso no conflicts -- confirmed via merge-base before merging.\n\nBrings in: the full COMM Gateway application (comm_gateway/, previously\nabsent from main entirely), the Telegram production bridge, onboarding\nresponse delivery, safe message chunking, and the 2026-08-21 resilience/\nrate-limiting/backup fix (commit 0c33580).","timestamp":"2026-08-21T07:58:11Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/814a8eda3fb1ada7ccc9eb5010a6e874a3cea285","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:58:11Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:58:11Z"},"added":["communication/Dockerfile.comm-gateway","communication/comm_gateway/__init__.py","communication/comm_gateway/config.py","communication/comm_gateway/hermes_client.py","communication/comm_gateway/main.py","communication/comm_gateway/ratelimit.py","communication/comm_gateway/telegram.py","communication/comm_gateway/telegram_outbound.py","communication/requirements.txt","communication/scripts/comm-1-backup-volumes.sh","communication/scripts/comm-hermes-client-resilience-check.py","communication/scripts/comm-telegram-message-chunking-check.py","communication/scripts/comm-telegram-onboarding-check.py","communication/scripts/comm-telegram-onboarding-route-check.py"],"removed":[],"modified":["communication/.env.example","communication/docker-compose.yml"]}],"head_commit":{"id":"814a8eda3fb1ada7ccc9eb5010a6e874a3cea285","tree_id":"6a783cb32832ca9cec7f01627c51caf56f844356","distinct":true,"message":"merge: bring the deployed COMM Gateway branch into main\n\nReconciles main with feature/comm-telegram-message-chunking, the branch\nactually running on COMM-1. This was a clean, non-overlapping divergence\n(main only touched intelligence/, this branch only touched communication/)\nso no conflicts -- confirmed via merge-base before merging.\n\nBrings in: the full COMM Gateway application (comm_gateway/, previously\nabsent from main entirely), the Telegram production bridge, onboarding\nresponse delivery, safe message chunking, and the 2026-08-21 resilience/\nrate-limiting/backup fix (commit 0c33580).","timestamp":"2026-08-21T07:58:11Z","url":"https://github.com/jobfynder/jobfynder-infra/commit/814a8eda3fb1ada7ccc9eb5010a6e874a3cea285","author":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:58:11Z"},"committer":{"name":"Pavan Kumar Narra","email":"benchteq@gmail.com","date":"2026-08-21T07:58:11Z"},"added":["communication/Dockerfile.comm-gateway","communication/comm_gateway/__init__.py","communication/comm_gateway/config.py","communication/comm_gateway/hermes_client.py","communication/comm_gateway/main.py","communication/comm_gateway/ratelimit.py","communication/comm_gateway/telegram.py","communication/comm_gateway/telegram_outbound.py","communication/requirements.txt","communication/scripts/comm-1-backup-volumes.sh","communication/scripts/comm-hermes-client-resilience-check.py","communication/scripts/comm-telegram-message-chunking-check.py","communication/scripts/comm-telegram-onboarding-check.py","communication/scripts/comm-telegram-onboarding-route-check.py"],"removed":[],"modified":["communication/.env.example","communication/docker-compose.yml"]}}
